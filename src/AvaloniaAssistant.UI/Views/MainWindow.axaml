<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:AvaloniaAssistant.UI.Views"
        xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
        x:Class="AvaloniaAssistant.UI.Views.MainWindow"
        Title="Avalonia Assistant"
        Icon="/Assets/app.ico"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        RequestedThemeVariant="Light">
  <Grid ColumnDefinitions="Auto,*">
    <views:SidebarView x:Name="Sidebar"
                       Width="268"
                       DataContext="{Binding}"
                       IsVisible="{Binding IsSidebarVisible}" />

    <Border Grid.Column="1"
            Margin="0,8,8,8"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
      <Grid>
        <ContentControl Content="{Binding CurrentPage}" />

        <!-- 窗口先显示再装配首页，避免中间那一下是一片空白 -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    IsVisible="{Binding IsPageLoading}">
          <arc:ArcSpinner Width="20" Height="20" Foreground="{StaticResource TextMutedBrush}" />
          <TextBlock Text="正在载入…" Classes="caption" HorizontalAlignment="Center" />
        </StackPanel>

        <Button Classes="icon"
                IsVisible="{Binding !IsSidebarVisible}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="展开侧边栏">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.PanelLeft}" Size="15" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
