<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:AvaloniaAssistant.UI.Views"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        x:Class="AvaloniaAssistant.UI.Views.MainWindow"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app.ico"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        RequestedThemeVariant="Light">
  <!-- 界面缩放走 LayoutTransform：既放大绘制，也把排版一起按比例算，
       不会出现字号变大但行高没跟上的重叠。 -->
  <LayoutTransformControl x:Name="RootTransform">
  <Grid x:Name="Root" ColumnDefinitions="Auto,Auto,*">
    <views:SidebarView x:Name="Sidebar"
                       Width="{Binding SidebarWidth}"
                       DataContext="{Binding}"
                       IsVisible="{Binding IsSidebarVisible}" />

    <!-- 侧栏宽度可拖：长任务名和深层目录不该只能靠悬停卡片看全 -->
    <Border x:Name="SidebarResizer"
            Grid.Column="1"
            Width="5"
            Margin="2,0"
            Background="Transparent"
            Cursor="SizeWestEast"
            IsVisible="{Binding IsSidebarVisible}"
            ToolTip.Tip="拖动调整侧栏宽度"
            PointerPressed="OnSidebarResizerPressed"
            PointerMoved="OnSidebarResizerMoved"
            PointerReleased="OnSidebarResizerReleased" />

    <Border Grid.Column="2"
            Margin="0,8,8,8"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
      <Grid>
        <ContentControl Content="{Binding CurrentPage}" />

        <Button Classes="icon"
                IsVisible="{Binding !IsSidebarVisible}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="展开侧边栏">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.PanelLeft}" Size="15" />
        </Button>
      </Grid>
    </Border>
  </Grid>
  </LayoutTransformControl>
</Window>
