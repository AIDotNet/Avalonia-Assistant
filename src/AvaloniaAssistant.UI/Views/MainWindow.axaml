<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:AvaloniaAssistant.UI.Views"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        x:Class="AvaloniaAssistant.UI.Views.MainWindow"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app.ico"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        RequestedThemeVariant="Light">
  <!-- 界面缩放走 LayoutTransform：既放大绘制，也把排版一起按比例算，
       不会出现字号变大但行高没跟上的重叠。 -->
  <LayoutTransformControl x:Name="RootTransform">
  <Grid x:Name="Root" ColumnDefinitions="Auto,Auto,*">
    <views:SidebarView x:Name="Sidebar"
                       Width="{Binding SidebarWidth}"
                       DataContext="{Binding}"
                       IsVisible="{Binding IsSidebarVisible}" />

    <!-- 折叠态占一条窄轨：展开按钮 + 五个主导航图标。
         以前窄轨只放「展开」，折起后想换页必须先展开；现在图标能直达。
         窄轨和页面各自一块地方：左边是「侧栏」，右边是「这一页」。 -->
    <Border Grid.Column="0"
            Width="48"
            IsVisible="{Binding !IsSidebarVisible}"
            Background="{StaticResource SidebarBrush}">
      <StackPanel Margin="0,14,0,0" Spacing="4" HorizontalAlignment="Center">
        <Button Classes="icon"
                Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="展开侧边栏">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.PanelLeft}" Size="15" />
        </Button>
        <Border Height="1" Width="24" Margin="0,6"
                Background="{StaticResource BorderBrush}" />

        <Button Classes="icon" Command="{Binding OpenHomeCommand}" ToolTip.Tip="助理">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}" Size="16" />
        </Button>
        <Button Classes="icon" Command="{Binding OpenWorkbenchCommand}" ToolTip.Tip="工作台">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.FolderOpen}" Size="16" />
        </Button>
        <Button Classes="icon" Command="{Binding OpenToolsCommand}" ToolTip.Tip="技能">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Zap}" Size="16" />
        </Button>
        <Button Classes="icon" Command="{Binding OpenMcpCommand}" ToolTip.Tip="MCP">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Server}" Size="16" />
        </Button>
        <Button Classes="icon" Command="{Binding OpenPluginsCommand}" ToolTip.Tip="插件">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Package}" Size="16" />
        </Button>
      </StackPanel>
    </Border>

    <!-- 侧栏宽度可拖：长任务名和深层目录不该只能靠悬停卡片看全 -->
    <Border x:Name="SidebarResizer"
            Grid.Column="1"
            Width="5"
            Margin="2,0"
            Background="Transparent"
            Cursor="SizeWestEast"
            IsVisible="{Binding IsSidebarVisible}"
            ToolTip.Tip="拖动调整侧栏宽度"
            PointerPressed="OnSidebarResizerPressed"
            PointerMoved="OnSidebarResizerMoved"
            PointerReleased="OnSidebarResizerReleased" />

    <Border Grid.Column="2"
            Margin="0,8,8,8"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
      <Grid>
        <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" />
      </Grid>
    </Border>
  </Grid>
  </LayoutTransformControl>
</Window>
