<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:AvaloniaAssistant.UI.Views"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        x:Class="AvaloniaAssistant.UI.Views.MainWindow"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app.ico"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        RequestedThemeVariant="Light">
  <Grid ColumnDefinitions="Auto,*">
    <views:SidebarView Width="268" DataContext="{Binding}" IsVisible="{Binding IsSidebarVisible}" />

    <Border Grid.Column="1"
            Margin="0,8,8,8"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
      <Grid>
        <ContentControl Content="{Binding CurrentPage}" />

        <Button Classes="icon"
                IsVisible="{Binding !IsSidebarVisible}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="展开侧边栏">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.PanelLeft}" Size="15" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
