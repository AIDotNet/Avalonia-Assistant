<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="AvaloniaAssistant.UI.Views.ComposerView">
  <StackPanel>
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="14,10,12,9"
            BoxShadow="{StaticResource ComposerShadow}">
      <Grid RowDefinitions="Auto,Auto">
        <Panel>
          <TextBox x:Name="Input"
                   Classes="composer"
                   Text="{Binding Text, Mode=TwoWay}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="46"
                   MaxHeight="170"
                   KeyDown="OnInputKeyDown" />
          <TextBlock Text="{Binding Placeholder}"
                     IsVisible="{Binding IsEmpty}"
                     IsHitTestVisible="False"
                     Foreground="{StaticResource TextMutedBrush}"
                     FontSize="14"
                     Margin="4,2,0,0" />
        </Panel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
          <Button Classes="icon"
                  Command="{Binding AttachCommand}"
                  ToolTip.Tip="把文件路径交给助手">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Paperclip}" Size="16" />
          </Button>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="pill" Click="OnModelClick" ToolTip.Tip="切换模型">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Monitor}" Size="13" />
                <TextBlock Text="{Binding ModelLabel}" FontSize="12" VerticalAlignment="Center" />
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}" Size="12" />
              </StackPanel>
            </Button>

            <Button Classes="pill" Click="OnPermissionClick" ToolTip.Tip="工具权限">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Shield}" Size="13" />
                <TextBlock Text="{Binding PermissionLabel}" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="send"
                    Command="{Binding SendCommand}"
                    IsVisible="{Binding ShowSend}"
                    ToolTip.Tip="发送（Enter）">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ArrowUp}" Size="17" />
            </Button>

            <Button Classes="stop"
                    Command="{Binding StopCommand}"
                    IsVisible="{Binding ShowStop}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Square}" Size="11" />
                <TextBlock Text="停止" FontSize="12" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="*,Auto" Margin="4,7,4,0">
      <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
        <Button Classes="pill" Click="OnWorkspaceClick" ToolTip.Tip="{Binding WorkspacePath}">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Folder}" Size="12" />
            <TextBlock Text="{Binding WorkspaceLabel}" FontSize="11.5" />
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}" Size="11" />
          </StackPanel>
        </Button>
        <TextBlock Text="本地运行" Classes="caption" VerticalAlignment="Center" Margin="6,0,0,0" />
      </StackPanel>
      <TextBlock Grid.Column="1"
                 Text="Enter 发送 · Shift+Enter 换行"
                 Classes="caption"
                 VerticalAlignment="Center" />
    </Grid>
  </StackPanel>
</UserControl>
