<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        x:Class="AvaloniaAssistant.UI.Views.ConfirmDialog"
        Title="确认"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}"
        RequestedThemeVariant="Light">
  <!-- 与 RunningTasksDialog 同一套：窗口铺满父窗口，这层半透明黑就是遮罩 -->
  <Grid Background="#66000000">
    <Border Width="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="24,20,24,18"
            BoxShadow="0 24 64 0 #33000000">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="26"
                  Height="26"
                  CornerRadius="13"
                  Background="{StaticResource WarningSubtleBrush}"
                  VerticalAlignment="Top">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.TriangleAlert}"
                          Size="15"
                          Foreground="{StaticResource WarningBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
          </Border>

          <TextBlock x:Name="TitleText"
                     Grid.Column="1"
                     Text="确认"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Margin="10,0,8,0"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />

          <Button Grid.Column="2"
                  Classes="icon"
                  Click="OnCancelClick"
                  ToolTip.Tip="取消">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.CircleX}" Size="15" />
          </Button>
        </Grid>

        <TextBlock x:Name="MessageText"
                   Text=""
                   FontSize="12.5"
                   LineHeight="20"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    HorizontalAlignment="Right"
                    Margin="0,2,0,0">
          <Button x:Name="CancelButton"
                  Classes="chip"
                  Content="取消"
                  MinWidth="88"
                  HorizontalContentAlignment="Center"
                  Click="OnCancelClick" />
          <Button x:Name="ConfirmButton"
                  Classes="approve"
                  Content="确定"
                  MinWidth="96"
                  Click="OnConfirmClick" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
