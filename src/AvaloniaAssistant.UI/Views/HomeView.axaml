<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:views="using:AvaloniaAssistant.UI.Views"
             xmlns:controls="using:AvaloniaAssistant.UI.Controls"
             x:Class="AvaloniaAssistant.UI.Views.HomeView">
  <!-- Background=Transparent：空白处也要能命中，拖文件到卡片之间才算落在这一页上 -->
  <Grid RowDefinitions="Auto,*" Background="Transparent">
    <Grid Margin="28,16,28,0" ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding Greeting}"
                 Classes="caption"
                 FontSize="12"
                 VerticalAlignment="Center" />
      <!-- 工作区切换只留在输入框下面那一条，右上角不再重复一个入口 -->
      <Button Grid.Column="1" Classes="icon" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="设置">
        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Settings}" Size="15" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="800"
                  HorizontalAlignment="Center"
                  Margin="28,14,28,10">

        <controls:BrandMark Width="44" Height="44" HorizontalAlignment="Center" />

        <TextBlock Text="{Binding Headline}"
                   FontSize="32"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0" />

        <TextBlock Text="{Binding Subtitle}"
                   Classes="muted"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Margin="0,7,0,0" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="0,12,0,0">
          <Button Classes="chip mode-chip"
                  Classes.active="{Binding IsOffice}"
                  Command="{Binding SetModeCommand}"
                  CommandParameter="office"
                  ToolTip.Tip="日常办公：之后新建的任务默认用它">
            <TextBlock Text="日常办公" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Classes="chip mode-chip"
                  Classes.active="{Binding IsDevelopment}"
                  Command="{Binding SetModeCommand}"
                  CommandParameter="development"
                  ToolTip.Tip="代码开发：之后新建的任务默认用它">
            <TextBlock Text="代码开发" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Classes="chip mode-chip"
                  Classes.active="{Binding IsDesign}"
                  Command="{Binding SetModeCommand}"
                  CommandParameter="design"
                  ToolTip.Tip="设计创意：之后新建的任务默认用它">
            <TextBlock Text="设计创意" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </StackPanel>

        <TextBlock Text="{Binding ModeHint}"
                   Classes="caption"
                   FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="520"
                   Margin="0,8,0,0" />

        <Border IsVisible="{Binding ShowSetupBanner}"
                Background="{StaticResource WarningSubtleBrush}"
                BorderBrush="#EFD9B8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,11"
                Margin="0,14,0,0">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Key}"
                          Size="16"
                          Foreground="{StaticResource WarningBrush}"
                          VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="2">
              <TextBlock Text="还没有配置模型服务" FontSize="12.5" FontWeight="Medium" />
              <TextBlock Text="填入 API Key 后就能开始；密钥只保存在本机。" Classes="caption" />
            </StackPanel>
            <Button Grid.Column="2"
                    Classes="ghost-action"
                    Command="{Binding OpenSettingsCommand}"
                    Content="去设置"
                    Foreground="{StaticResource TextPrimaryBrush}" />
          </Grid>
        </Border>

        <views:ComposerView DataContext="{Binding Composer}" Margin="0,12,0,0" />

        <ItemsControl ItemsSource="{Binding QuickPrompts}" Margin="0,10,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="8" LineSpacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="chip"
                      Height="31"
                      Padding="12,0"
                      CornerRadius="16"
                      FontSize="11.5"
                      Content="{Binding Label}"
                      Command="{Binding $parent[ItemsControl].DataContext.UseQuickPromptCommand}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="或者，从这些开始"
                   Classes="section-title"
                   Margin="2,16,0,8" />

        <!-- WorkBuddy 首页的类别胶囊：选一个类别，下面四张模板卡跟着换。
             悬停模板会在输入框里用灰字预览整段提示词，点一下才真正填入。 -->
        <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,0,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="7" LineSpacing="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="chip category-chip"
                      Classes.active="{Binding IsSelected}"
                      Content="{Binding Label}"
                      Command="{Binding $parent[ItemsControl].DataContext.SelectCategoryCommand}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding CategoryHint}"
                   IsVisible="{Binding HasCategoryHint}"
                   Classes="caption"
                   FontSize="10.5"
                   Foreground="{StaticResource TextMutedBrush}"
                   Margin="2,0,0,10" />

        <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,-12,-12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- 卡身 = 填入输入框，可以改完再发；右上角箭头才是「直接开始」。
                   以前整张卡都是「点了就跑」，想改一个词都没机会。 -->
              <Grid Margin="0,0,12,12"
                    PointerEntered="OnCardPointerEntered"
                    PointerExited="OnCardPointerExited">
                <Button Classes="card-button"
                        Command="{Binding $parent[ItemsControl].DataContext.FillCardCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="悬停预览整段提示词 · 点一下填入输入框，可以改完再发">
                  <Border Classes="card" Padding="14" Height="96">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource SurfaceMutedBrush}" VerticalAlignment="Top">
                        <arc:ArcGlyph Data="{Binding Icon}"
                                      Size="17"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="11,1,8,0" Spacing="4">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" Padding="0,0,26,0" />
                        <TextBlock Text="{Binding Subtitle}"
                                   Classes="caption"
                                   TextWrapping="Wrap"
                                   LineHeight="17" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </Button>

                <Button Classes="card-run"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,7,7,0"
                        Command="{Binding $parent[ItemsControl].DataContext.RunCardCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="直接开始：新建任务并消耗一次请求">
                  <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ArrowUpRight}" Size="12" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="内容由 AI 生成，请核对重要信息。"
                   Classes="caption"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
