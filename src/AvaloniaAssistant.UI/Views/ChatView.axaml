<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:AvaloniaAssistant.UI.ViewModels"
             xmlns:views="using:AvaloniaAssistant.UI.Views"
             xmlns:controls="using:AvaloniaAssistant.UI.Controls"
             x:Class="AvaloniaAssistant.UI.Views.ChatView">

  <UserControl.Styles>
    <!-- 消息列表的滚动条常驻显示：自动隐藏时只剩一条 2~3px 的细线，鼠标根本抓不住 -->
    <Style Selector="ScrollViewer.message-list /template/ ScrollBar">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <!-- 停在上面看历史时的浮标：有新内容 / 有操作待确认，点一下回到底部 -->
    <Style Selector="Button.jump-latest">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.jump-latest:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    </Style>

    <!-- 工具调用压成一行：一次任务十几次调用，卡片会把人埋掉 -->
    <Style Selector="Button.tool-line">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="2,2" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool-line:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    </Style>

    <!-- 引用文件的可点标签：点一下在资源管理器里定位，hover 看完整路径和截断说明 -->
    <Style Selector="Button.attachment-chip">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.attachment-chip:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    </Style>

    <!-- 回复下面的操作项：以前和元信息同字号同灰度，分不清哪个能点 -->
    <Style Selector="Button.msg-action">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.msg-action:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 编辑提问的主按钮：比授权卡上的矮一档，跟消息区的小控件同一量级 -->
    <Style Selector="Button.edit-save">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.edit-save:pointerover">
      <Setter Property="Background" Value="#3A3A36" />
    </Style>
    <Style Selector="Button.edit-save:disabled">
      <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style Selector="Button.edit-save:disabled /template/ ContentPresenter">
      <Setter Property="TextBlock.Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:UserMessageViewModel}">
      <StackPanel>
      <TextBlock Text="{Binding DateHeaderText}"
                 IsVisible="{Binding ShowDateHeader}"
                 Classes="caption"
                 FontSize="10.5"
                 HorizontalAlignment="Center"
                 Margin="0,6,0,2" />
      <!-- 命中靠正文里的词标记，不再给整块消息铺底色：一大片黄压在白气泡上太抢眼，
           而且整条染黄也指不到具体是哪一句。Padding 6 / Margin 收 6，净位置和原来一致 -->
      <Border HorizontalAlignment="Right"
              CornerRadius="12"
              Padding="6"
              Margin="0,4,-6,12">
        <Grid HorizontalAlignment="Right">
        <StackPanel HorizontalAlignment="Right" Spacing="4">
          <Border Background="{StaticResource UserBubbleBrush}"
                  CornerRadius="16,16,4,16"
                  Padding="14,10"
                  MaxWidth="620"
                  IsVisible="{Binding ShowText}">
            <SelectableTextBlock Text="{Binding Text}"
                                 TextWrapping="Wrap"
                                 FontSize="13.5"
                                 LineHeight="21" />
          </Border>

          <!-- 就地改提问。改完从这句重来，比重新开一条任务把上下文全丢掉划算得多 -->
          <Border IsVisible="{Binding IsEditing}"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource BorderStrongBrush}"
                  BorderThickness="1"
                  CornerRadius="14"
                  Padding="10"
                  MaxWidth="620">
            <StackPanel Spacing="7">
              <arc:Textarea Text="{Binding EditText, Mode=TwoWay}"
                            MinWidth="360"
                            MinHeight="66"
                            MaxHeight="220"
                            FontSize="13"
                            Watermark="改完按「保存并重发」" />
              <TextBlock Text="保存后，这句之后的对话会被删掉并重新回答。"
                         Classes="caption"
                         FontSize="10" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                <Button Classes="msg-action" Command="{Binding CancelEditCommand}">
                  <TextBlock Text="取消" FontSize="11" />
                </Button>
                <Button Classes="edit-save"
                        Command="{Binding SaveEditCommand}"
                        IsEnabled="{Binding CanSaveEdit}">
                  <TextBlock Text="保存并重发" FontSize="11" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 这一轮贴的图，缩略图跟着气泡右对齐 -->
          <ItemsControl ItemsSource="{Binding Thumbnails}"
                        IsVisible="{Binding HasImages}"
                        HorizontalAlignment="Right"
                        Margin="0,2,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="10"
                        ClipToBounds="True"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip.Tip="点开看大图"
                        PointerPressed="OnThumbnailPressed">
                  <Image Source="{Binding}" Width="120" Stretch="Uniform" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 引用了哪些文件：可点，能定位到磁盘；大小、行数、截断状态都写在下面 -->
          <ItemsControl ItemsSource="{Binding Attachments}"
                        IsVisible="{Binding HasAttachments}"
                        HorizontalAlignment="Right"
                        Margin="0,2,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="attachment-chip"
                        ToolTip.Tip="{Binding Detail}"
                        Click="OnAttachmentClick">
                  <StackPanel Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Paperclip}"
                                    Size="11"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}"
                                 FontSize="10.5"
                                 MaxWidth="220"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding Caption}"
                               FontSize="9.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="16,0,0,0" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 时间戳：隔一天回来，得知道这轮是什么时候跑的。
               编辑入口放在同一行，不额外占高度 -->
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="4"
                      Margin="0,0,4,0">
            <Button Classes="msg-action"
                    IsVisible="{Binding CanEdit}"
                    Command="{Binding StartEditCommand}"
                    ToolTip.Tip="改这句，从它重新回答">
              <TextBlock Text="编辑" FontSize="10" />
            </Button>
            <TextBlock Text="{Binding TimeText}"
                       ToolTip.Tip="{Binding FullTimeText}"
                       Classes="caption"
                       FontSize="9.5"
                       VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        </Grid>
      </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AssistantMessageViewModel}">
      <StackPanel>
      <TextBlock Text="{Binding DateHeaderText}"
                 IsVisible="{Binding ShowDateHeader}"
                 Classes="caption"
                 FontSize="10.5"
                 HorizontalAlignment="Center"
                 Margin="0,6,0,2" />
      <!-- 命中只标正文里的词，不给整块消息铺底色。Padding 6 / Margin 收 6，净位置和原来一致 -->
      <Border CornerRadius="12"
              Padding="6"
              Margin="-6,-4,-6,20">
        <Grid ColumnDefinitions="28,*">
        <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                        Size="14"
                        Foreground="{StaticResource AccentForegroundBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="7">
          <!-- 执行计划：多步任务先把打算怎么做摆出来，用户能在第一步之前就叫停。
               没有计划时整块不出现，单步任务不会多一个空框。 -->
          <Border IsVisible="{Binding HasPlan}"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12,9"
                  MaxWidth="620"
                  HorizontalAlignment="Left">
            <StackPanel Spacing="5">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <arc:ArcGlyph Data="{x:Static arc:ArcIcons.CircleCheck}"
                                Size="13"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="执行计划" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding PlanSummary}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Plan}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                      <!-- 三种状态三个图标叠在同一格，靠可见性切换，行高不会跟着跳 -->
                      <Panel Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,0,0">
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.CircleCheck}"
                                      Size="12"
                                      IsVisible="{Binding IsDone}"
                                      Foreground="{Binding GlyphBrush}" />
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Clock}"
                                      Size="12"
                                      IsVisible="{Binding IsCurrent}"
                                      Foreground="{Binding GlyphBrush}" />
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Square}"
                                      Size="12"
                                      IsVisible="{Binding IsPending}"
                                      Foreground="{Binding GlyphBrush}" />
                      </Panel>
                      <TextBlock Grid.Column="1"
                                 Margin="7,0,0,0"
                                 Text="{Binding Text}"
                                 FontSize="11.5"
                                 LineHeight="17"
                                 TextWrapping="Wrap"
                                 Foreground="{Binding Foreground}"
                                 TextDecorations="{Binding Decorations}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding HasReasoning}"
                  Background="{StaticResource SurfaceMutedBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10,7">
            <StackPanel Spacing="4">
              <Button Classes="ghost-action"
                      HorizontalAlignment="Left"
                      Command="{Binding ToggleReasoningCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}" Size="12" />
                  <TextBlock Text="思考过程" FontSize="11.5" />
                  <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}" Size="11" />
                </StackPanel>
              </Button>
              <ScrollViewer MaxHeight="220"
                            IsVisible="{Binding IsReasoningOpen}"
                            VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Reasoning}"
                           TextWrapping="Wrap"
                           FontSize="11.5"
                           LineHeight="18"
                           Foreground="{StaticResource TextSecondaryBrush}" />
              </ScrollViewer>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Tools}">
            <!-- 相邻的工具卡片之间留出间距，否则连续多次调用会贴成一整块 -->
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Button Classes="tool-line"
                          Command="{Binding ToggleCommand}"
                          ToolTip.Tip="{Binding ExpandHint}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                      <arc:ArcGlyph Data="{Binding Icon}"
                                    Size="12"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Margin="8,0,8,0"
                                 Text="{Binding Summary}"
                                 FontSize="12"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding StatusText}"
                                 IsVisible="{Binding ShowStatus}"
                                 Foreground="{Binding StatusBrush}"
                                 FontSize="10.5"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding DurationText}"
                                 Classes="caption"
                                 FontSize="10"
                                 Margin="8,0,2,0"
                                 VerticalAlignment="Center" />
                      <!-- 没有箭头时，这一行看起来就是一段灰字，没人知道能点开 -->
                      <Panel Grid.Column="4"
                             Width="12"
                             Height="12"
                             Margin="4,0,0,0"
                             VerticalAlignment="Center">
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}"
                                      Size="11"
                                      IsVisible="{Binding IsExpanded}"
                                      Foreground="{StaticResource TextMutedBrush}" />
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronRight}"
                                      Size="11"
                                      IsVisible="{Binding !IsExpanded}"
                                      Foreground="{StaticResource TextMutedBrush}" />
                      </Panel>
                    </Grid>
                  </Button>

                  <!-- 展开的细节不再套一层卡片，只缩进一档，跟正文同一条竖线 -->
                  <StackPanel IsVisible="{Binding IsExpanded}" Margin="20,3,0,6" Spacing="4">
                    <!-- 目标物可直达：路径去资源管理器、网址去浏览器、命令只给复制 -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Button Classes="ghost-action"
                              Command="{Binding OpenTargetCommand}"
                              IsVisible="{Binding CanOpenTarget}"
                              ToolTip.Tip="{Binding Target}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ArrowUpRight}" Size="10" />
                          <TextBlock Text="{Binding OpenTargetHint}" FontSize="10.5" />
                        </StackPanel>
                      </Button>
                      <Button Classes="ghost-action"
                              Command="{Binding CopyTargetCommand}"
                              IsVisible="{Binding ShowCopyTarget}"
                              ToolTip.Tip="复制这次操作的对象">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Copy}" Size="10" />
                          <TextBlock Text="复制目标" FontSize="10.5" />
                        </StackPanel>
                      </Button>
                    </StackPanel>

                    <TextBlock Text="参数" Classes="section-title" FontSize="10" />
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                      <SelectableTextBlock Text="{Binding Arguments}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                    </ScrollViewer>

                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasResult}" Margin="0,4,0,0">
                      <TextBlock Text="结果" Classes="section-title" FontSize="10" VerticalAlignment="Center" />
                      <Button Grid.Column="1"
                              Classes="ghost-action"
                              Command="{Binding CopyResultCommand}"
                              ToolTip.Tip="复制这次工具的结果">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Copy}" Size="10" />
                          <TextBlock Text="复制结果" FontSize="10.5" />
                        </StackPanel>
                      </Button>
                    </Grid>
                    <ScrollViewer MaxHeight="200" IsVisible="{Binding HasResult}" VerticalScrollBarVisibility="Auto">
                      <SelectableTextBlock Text="{Binding Result}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                    </ScrollViewer>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <arc:Markdown Text="{Binding Text}" IsVisible="{Binding HasText}" />

          <StackPanel IsVisible="{Binding ShowTyping}" Orientation="Horizontal" Spacing="7" Margin="0,2,0,0">
            <arc:ArcSpinner Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Text="正在处理…" Classes="caption" VerticalAlignment="Center" />
          </StackPanel>

          <Border IsVisible="{Binding HasError}"
                  Background="{StaticResource DangerSubtleBrush}"
                  BorderBrush="#F0CFCB"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="10,8">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.CircleAlert}"
                              Size="13"
                              Foreground="{StaticResource DangerBrush}"
                              VerticalAlignment="Top"
                              Margin="0,1,0,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ErrorTitle}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="7,0,8,0"
                           VerticalAlignment="Center" />
                <!-- 401 点一百次重试也没用，按钮要指向真正能解决它的地方 -->
                <Button Grid.Column="2"
                        Classes="ghost-action"
                        Command="{Binding RunErrorActionCommand}"
                        IsVisible="{Binding ShowErrorAction}"
                        Content="{Binding ErrorActionLabel}"
                        Foreground="{StaticResource DangerBrush}"
                        VerticalAlignment="Top" />
              </Grid>

              <TextBlock Text="{Binding ErrorHint}"
                         IsVisible="{Binding ErrorHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         FontSize="11.5"
                         LineHeight="17"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}" />

              <!-- 原始报错留着，但压到最后一行，不占主位 -->
              <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding Error}"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="10.5"
                                     TextWrapping="Wrap"
                                     Foreground="{StaticResource TextMutedBrush}" />
              </ScrollViewer>
            </StackPanel>
          </Border>

          <!-- 用户按停不是故障：中性一行说明，不套危险色 -->
          <TextBlock IsVisible="{Binding HasStopNote}"
                     Text="已停止生成"
                     Classes="caption"
                     FontSize="11"
                     Foreground="{StaticResource TextMutedBrush}"
                     Margin="0,1,0,0" />

          <!-- 回复的操作菜单：复制要有内容才出现，重试只在这条回复真的结束（含失败/中断）后才出现 -->
          <Grid IsVisible="{Binding ShowActions}"
                ColumnDefinitions="Auto,*,Auto"
                Margin="0,1,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="1">
              <Button Classes="msg-action"
                      Command="{Binding CopyCommand}"
                      IsVisible="{Binding HasText}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Copy}" Size="11" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CopyLabel}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="msg-action"
                      Command="{Binding RetryCommand}"
                      ToolTip.Tip="重新生成这条回复（会丢弃它之后的内容）">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <arc:ArcGlyph Data="{x:Static arc:ArcIcons.RefreshCw}" Size="11" VerticalAlignment="Center" />
                  <TextBlock Text="重试" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="msg-action"
                      Command="{Binding ContinueCommand}"
                      IsVisible="{Binding ShowContinue}"
                      ToolTip.Tip="接着这条回复往下写，已写过的内容不重来">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Play}" Size="11" VerticalAlignment="Center" />
                  <TextBlock Text="继续" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- 元信息靠右，和操作分开；模型名也放进来，切换过模型后能回看哪条是谁答的 -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="7"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding Model}"
                         IsVisible="{Binding HasModel}"
                         ToolTip.Tip="这条回复使用的模型"
                         Classes="caption"
                         FontSize="9.5" />
              <TextBlock Text="{Binding TokenText}"
                         IsVisible="{Binding HasTokens}"
                         Classes="caption"
                         FontSize="9.5" />
              <TextBlock Text="{Binding TimeText}"
                         ToolTip.Tip="{Binding FullTimeText}"
                         Classes="caption"
                         FontSize="9.5" />
            </StackPanel>
          </Grid>
        </StackPanel>
        </Grid>
      </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ApprovalMessageViewModel}">
      <StackPanel>
      <TextBlock Text="{Binding DateHeaderText}"
                 IsVisible="{Binding ShowDateHeader}"
                 Classes="caption"
                 FontSize="10.5"
                 HorizontalAlignment="Center"
                 Margin="0,6,0,2" />
      <Border Background="{StaticResource WarningSubtleBrush}"
              BorderBrush="#EBCFA4"
              BorderThickness="1"
              CornerRadius="12"
              Padding="13"
              Margin="38,6,0,10"
              IsVisible="{Binding ShowActions}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Shield}"
                          Size="16"
                          Foreground="{StaticResource WarningBrush}"
                          VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Label}"
                       FontSize="12.5"
                       FontWeight="Medium"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
            <Border Grid.Column="2"
                    Background="#AAFFFFFF"
                    CornerRadius="6"
                    Padding="7,2"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding ToolName}"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="9.5"
                         Foreground="{StaticResource WarningBrush}" />
            </Border>
          </Grid>
          <TextBlock Text="{Binding Reason}"
                     Classes="caption"
                     FontSize="11.5"
                     TextWrapping="Wrap" />
          <!-- 参数可以直接改：模型给错路径/参数时，不用整轮拒绝再重述一遍。
               注意这是「拒绝这次调用 + 让模型带新参数重发」，不是就地改写工具入参——
               SDK 只给了拦截，没有改写入口，所以下面那行说明必须写清楚。 -->
          <Border Background="#AAFFFFFF" CornerRadius="8" Padding="10,7">
            <StackPanel Spacing="3">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="参数（可以直接改）"
                           Classes="section-title"
                           FontSize="10"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="ghost-action"
                        Content="还原"
                        Command="{Binding ResetArgumentsCommand}"
                        IsVisible="{Binding HasEdits}"
                        ToolTip.Tip="改回模型给的原始参数" />
              </Grid>

              <arc:Textarea Text="{Binding EditedArguments, Mode=TwoWay}"
                            AcceptsReturn="True"
                            IsResizable="False"
                            MinHeight="46"
                            MaxHeight="112"
                            FontFamily="{StaticResource MonoFontFamily}"
                            FontSize="10.5"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            CaretBrush="{StaticResource TextPrimaryBrush}"
                            Placeholder="工具参数" />

              <TextBlock Text="{Binding EditError}"
                         IsVisible="{Binding HasEditError}"
                         FontSize="10.5"
                         LineHeight="15"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource DangerBrush}" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" IsVisible="{Binding ShowActions}" Margin="0,2,0,0">
            <Button Classes="approve"
                    Command="{Binding AllowCommand}"
                    IsVisible="{Binding !HasEdits}"
                    Content="允许一次" />
            <!-- 改过参数就只留一个主按钮：两个「允许」并排，点错一次就是按旧参数跑了 -->
            <Button Classes="approve"
                    Command="{Binding AllowEditedCommand}"
                    IsVisible="{Binding HasEdits}"
                    Content="按修改重试"
                    ToolTip.Tip="拒绝这次调用，把改后的参数交给模型立刻重发一次" />
            <Button Grid.Column="2"
                    Classes="deny"
                    Margin="8,0,0,0"
                    Command="{Binding DenyCommand}"
                    Content="拒绝" />
            <Button Grid.Column="4"
                    Classes="ghost-action"
                    VerticalAlignment="Center"
                    Command="{Binding AllowAlwaysCommand}"
                    ToolTip.Tip="这个工具在本次对话里不再逐次询问"
                    Content="{Binding AlwaysLabel}" />
          </Grid>

          <TextBlock Text="改完按「按修改重试」：这次调用会被拦下，模型带着新参数立刻重发，重发的那一次不再重复问你。"
                     IsVisible="{Binding HasEdits}"
                     Classes="caption"
                     FontSize="10"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Right" />

          <TextBlock Text="Ctrl+Enter 允许一次 · Ctrl+Shift+Enter 本会话允许 · Esc 拒绝"
                     IsVisible="{Binding ShowActions}"
                     Classes="caption"
                     FontSize="10"
                     HorizontalAlignment="Right" />
        </StackPanel>
      </Border>

      <!-- 已经答过的审批：收成一行，别再用一整块黄色占着对话 -->
      <Border IsVisible="{Binding !ShowActions}"
              Background="{StaticResource SurfaceMutedBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="7,4"
              Margin="38,2,0,12">
        <StackPanel Spacing="4">
          <Button Classes="tool-line"
                  Command="{Binding ToggleExpandedCommand}"
                  ToolTip.Tip="{Binding ExpandHint}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Shield}"
                            Size="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Margin="8,0,8,0"
                         Text="{Binding ResolutionText}"
                         FontSize="11.5"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         VerticalAlignment="Center" />
              <Border Grid.Column="2"
                      Background="{StaticResource SurfaceBrush}"
                      CornerRadius="5"
                      Padding="6,1"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding ToolName}"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="9.5"
                           Foreground="{StaticResource TextMutedBrush}" />
              </Border>
              <Panel Grid.Column="3"
                     Width="12"
                     Height="12"
                     Margin="6,0,0,0"
                     VerticalAlignment="Center">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}"
                              Size="11"
                              IsVisible="{Binding IsExpanded}"
                              Foreground="{StaticResource TextMutedBrush}" />
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronRight}"
                              Size="11"
                              IsVisible="{Binding !IsExpanded}"
                              Foreground="{StaticResource TextMutedBrush}" />
              </Panel>
            </Grid>
          </Button>

          <Border IsVisible="{Binding IsExpanded}"
                  Background="{StaticResource SurfaceBrush}"
                  CornerRadius="8"
                  Padding="10,7"
                  Margin="0,2,0,2">
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
              <SelectableTextBlock Text="{Binding Arguments}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NoticeMessageViewModel}">
      <StackPanel>
      <TextBlock Text="{Binding DateHeaderText}"
                 IsVisible="{Binding ShowDateHeader}"
                 Classes="caption"
                 FontSize="10.5"
                 HorizontalAlignment="Center"
                 Margin="0,6,0,2" />
      <Border Background="{StaticResource SurfaceMutedBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="11,9"
              Margin="0,4,0,12">
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
      </Border>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <!-- Background=Transparent：空白处也要能命中，拖文件到消息区中间才算落在这一页上 -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="Transparent">
    <Border Grid.Row="0"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="18,12,16,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <Button Classes="icon" Command="{Binding BackCommand}" ToolTip.Tip="返回首页" Margin="0,0,6,0">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronLeft}" Size="16" />
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding HeaderSubtitle}"
                     Classes="caption"
                     FontSize="10.5"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding UsageHint}" />
        </StackPanel>
        <!-- 停止已经在输入框里（运行中发送键会变成停止键），重试挂在每条回复下面，
             顶栏只留查找、导出和状态，避免同一个动作出现两处入口。 -->
        <Button Grid.Column="2"
                Classes="icon"
                Margin="0,0,6,0"
                Command="{Binding OpenSearchCommand}"
                ToolTip.Tip="在对话里查找（Ctrl+F）">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Search}" Size="14" />
        </Button>
        <Button Grid.Column="3"
                Classes="icon"
                Margin="0,0,6,0"
                Command="{Binding ExportCommand}"
                ToolTip.Tip="导出为 Markdown">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.FileText}" Size="14" />
        </Button>
        <!-- 产物入口：没有改动过文件时整颗按钮不出现，不留一个点不动的空位 -->
        <Button Grid.Column="4"
                Classes="icon artifact-toggle"
                Margin="0,0,6,0"
                IsVisible="{Binding HasArtifacts}"
                Command="{Binding ToggleArtifactPanelCommand}"
                ToolTip.Tip="{Binding ArtifactToggleHint}">
          <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.FolderOpen}" Size="14" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ArtifactCount}" FontSize="10" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Border Grid.Column="5"
                Background="{StaticResource SurfaceMutedBrush}"
                CornerRadius="11"
                Padding="10,4"
                VerticalAlignment="Center"
                ToolTip.Tip="本轮已用时。跑完会停下并保留总时长。">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- 状态词里带工具名，长的能到二十几个字：限宽省略，否则胶囊会顶出窗口右边缘，
                 计时也跟着被裁掉——那正好是用户最想看的那一段。 -->
            <TextBlock Text="{Binding StatusText}"
                       Classes="caption"
                       FontSize="10.5"
                       MaxWidth="210"
                       TextTrimming="CharacterEllipsis" />
            <!-- 等了两分钟却不知道是在想还是卡住了：状态词旁边挂一个走动的秒表 -->
            <TextBlock Text="{Binding RunClockText}"
                       IsVisible="{Binding HasRunClock}"
                       Classes="caption"
                       FontSize="10.5"
                       Opacity="0.62" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- 会话内查找：单独占一条，收起时整行不占位，也不压住正文第一行 -->
    <Border Grid.Row="1"
            IsVisible="{Binding IsSearchOpen}"
            Background="{StaticResource SurfaceMutedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="18,7">
      <StackPanel Spacing="3">
      <StackPanel Orientation="Horizontal"
                  Spacing="6"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Search}"
                      Size="13"
                      Foreground="{StaticResource TextMutedBrush}"
                      VerticalAlignment="Center" />
        <arc:Input x:Name="SearchInput"
                   Width="188"
                   Size="Small"
                   Placeholder="在对话里查找"
                   Text="{Binding SearchQuery, Mode=TwoWay}" />
        <TextBlock Text="{Binding SearchCounter}"
                   Classes="caption"
                   FontSize="10.5"
                   MinWidth="78"
                   VerticalAlignment="Center" />
        <Button Classes="icon"
                Width="24"
                Height="24"
                Command="{Binding PreviousSearchHitCommand}"
                ToolTip.Tip="上一处（Shift+Enter）">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronUp}" Size="13" />
        </Button>
        <Button Classes="icon"
                Width="24"
                Height="24"
                Command="{Binding NextSearchHitCommand}"
                ToolTip.Tip="下一处（Enter）">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}" Size="13" />
        </Button>
        <Button Classes="icon"
                Width="24"
                Height="24"
                Command="{Binding CloseSearchCommand}"
                ToolTip.Tip="关闭（Esc）">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.CircleX}" Size="13" />
        </Button>
      </StackPanel>

        <!-- 命中在哪：整条染黄之外给一句上下文，长回复里不用自己找那一行 -->
        <TextBlock Text="{Binding SearchSnippet}"
                   IsVisible="{Binding HasSearchSnippet}"
                   Classes="caption"
                   FontSize="10"
                   MaxWidth="780"
                   HorizontalAlignment="Right"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding SearchSnippet}" />
      </StackPanel>
    </Border>

    <!-- 消息区 + 产物面板：只在这条任务真的改过文件时才分出一栏，没改过还是原来那一整片 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
    <Panel Grid.Column="0">
      <ScrollViewer x:Name="MessagesScroll"
                    Classes="message-list"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="MessagesItems"
                      ItemsSource="{Binding Messages}"
                      MaxWidth="840"
                      Margin="26,22,26,10"
                      />
      </ScrollViewer>

      <!-- 刚建的新任务：给上下文和三个入口，不留一块空白 -->
      <StackPanel IsVisible="{Binding ShowEmptyState}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="430"
                  Spacing="9"
                  Margin="26,0,26,30"
                  IsHitTestVisible="False">
        <Border Width="44"
                Height="44"
                CornerRadius="14"
                Background="{StaticResource SurfaceMutedBrush}"
                HorizontalAlignment="Center">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                        Size="20"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
        </Border>

        <TextBlock Text="这个任务还没开始"
                   FontSize="15"
                   FontWeight="Medium"
                   HorizontalAlignment="Center" />

        <TextBlock Text="{Binding HeaderSubtitle}"
                   Classes="caption"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="400" />

        <Border Background="{StaticResource SurfaceMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,11"
                Margin="0,3,0,0">
          <StackPanel Spacing="7">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Paperclip}"
                            Size="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            VerticalAlignment="Center" />
              <TextBlock Text="输入 @ 引用工作区里的文件，发送时才读正文"
                         FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Folder}"
                            Size="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            VerticalAlignment="Center" />
              <TextBlock Text="把文件拖进窗口任意位置，松开即引用"
                         FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Copy}"
                            Size="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            VerticalAlignment="Center" />
              <TextBlock Text="Ctrl+V 贴图，图片会和文字一起发"
                         FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="新任务默认是普通任务；要从某个目录开始，先在输入框下面选工作区。"
                   Classes="caption"
                   FontSize="10.5"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="380" />
      </StackPanel>

      <Button Classes="jump-latest"
              IsVisible="{Binding ShowFloatingHint}"
              Command="{Binding JumpToLatestCommand}"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,14">
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ArrowDown}" Size="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding FloatingHint}" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Panel>

    <!-- 产物：这次任务到底动了哪些文件。工具卡说的是过程，这里说的是结果。
         没有产物时整栏不出现，消息区回到原来那一整片。 -->
    <Border Grid.Column="1"
            Width="304"
            IsVisible="{Binding ShowArtifactPanel}"
            Background="{StaticResource SurfaceMutedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,12,8,8">
          <StackPanel Spacing="2">
            <TextBlock Text="产物" FontSize="12.5" FontWeight="Medium" />
            <TextBlock Text="{Binding ArtifactSummary}"
                       FontSize="10"
                       Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="msg-action"
                  Command="{Binding ToggleArtifactPanelCommand}"
                  ToolTip.Tip="收起产物面板"
                  VerticalAlignment="Top">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronRight}" Size="12" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="8,0,8,10">
          <ItemsControl ItemsSource="{Binding Artifacts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,9"
                        Margin="0,0,0,6">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <arc:ArcGlyph Data="{x:Static arc:ArcIcons.FileText}"
                                    Size="13"
                                    Margin="0,2,7,0"
                                    VerticalAlignment="Top"
                                    Foreground="{Binding KindBrush}" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding FileName}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Detail}" />
                        <TextBlock Text="{Binding Folder}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasFolder}" />
                      </StackPanel>
                      <Border Grid.Column="2"
                              Background="{StaticResource SurfaceMutedBrush}"
                              CornerRadius="4"
                              Padding="5,1"
                              VerticalAlignment="Top">
                        <TextBlock Text="{Binding KindText}"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="{Binding KindBrush}" />
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Text="{Binding ChangeText}"
                                 FontSize="10"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding KindBrush}" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button Classes="msg-action"
                                IsVisible="{Binding HasDiff}"
                                Command="{Binding ToggleCommand}"
                                ToolTip.Tip="{Binding ExpandHint}">
                          <TextBlock Text="差异" FontSize="10" />
                        </Button>
                        <!-- 能在应用内看内容就别弹出去：文档类文件点一次就能读 -->
                        <Button Classes="msg-action"
                                IsVisible="{Binding CanPreview}"
                                Command="{Binding PreviewCommand}"
                                ToolTip.Tip="在应用内预览内容（文字与表格，非版式）">
                          <TextBlock Text="预览" FontSize="10" />
                        </Button>
                        <Button Classes="msg-action" Command="{Binding OpenCommand}" ToolTip.Tip="用默认程序打开">
                          <TextBlock Text="打开" FontSize="10" />
                        </Button>
                        <Button Classes="msg-action" Command="{Binding RevealCommand}" ToolTip.Tip="在资源管理器中定位">
                          <TextBlock Text="定位" FontSize="10" />
                        </Button>
                      </StackPanel>
                    </Grid>

                    <!-- 逐行差异：+ 绿 − 红，跟代码托管站一致，用户不用再学一套配色。
                         窄栏里横向滚动反而更难读，长行折行、整行铺满。 -->
                    <Border IsVisible="{Binding IsExpanded}"
                            Background="{StaticResource CodeBackgroundBrush}"
                            CornerRadius="8"
                            Padding="0,5"
                            MaxHeight="260">
                      <ScrollViewer VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Lines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="{Binding Background}"
                                      Padding="8,0"
                                      HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding Text}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10.5"
                                           LineHeight="16"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding Foreground}" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
    </Grid>

    <Border Grid.Row="3" Padding="26,8,26,14" Background="{StaticResource SurfaceBrush}">
      <StackPanel MaxWidth="840" HorizontalAlignment="Center">
        <!-- 上下文水位：低于 40% 不出现；超过 70% 提示会开始压缩早期内容。
             分母跟着当前模型的窗口走，查不到时数字后面带 * -->
        <StackPanel IsVisible="{Binding ShowContextMeter}"
                    Margin="2,0,2,6"
                    Spacing="3"
                    ToolTip.Tip="{Binding ContextMeterHint}">
          <Grid ColumnDefinitions="*,Auto">
            <!-- 自绘水位：轨道 720 + 填充按比例，ProgressBar 在当前主题里 3px 高看不见 -->
            <Border Height="4"
                    Width="720"
                    CornerRadius="2"
                    Background="{StaticResource SurfaceMutedBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ClipToBounds="True">
              <Border Width="{Binding ContextMeterWidth}"
                      Background="{Binding ContextMeterBrush}"
                      CornerRadius="2"
                      HorizontalAlignment="Left" />
            </Border>
            <TextBlock Grid.Column="1"
                       Text="{Binding ContextUsageText}"
                       FontSize="9.5"
                       Margin="8,0,0,0"
                       Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center" />
          </Grid>
          <TextBlock IsVisible="{Binding IsContextTight}"
                     Text="上下文快满了：再聊几轮会压缩早期内容，模型可能记不住前面的细节。"
                     FontSize="10"
                     Foreground="{StaticResource TextMutedBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <!-- 等待确认常驻条：不管滚到哪儿、焦点在哪，这里都能看见还有操作等着 -->
        <Border IsVisible="{Binding HasPendingApproval}"
                Background="{StaticResource WarningSubtleBrush}"
                BorderBrush="#EBCFA4"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,7"
                Margin="0,0,0,8">
          <Button Background="Transparent"
                  BorderThickness="0"
                  Padding="0"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Command="{Binding JumpToApprovalCommand}"
                  ToolTip.Tip="回到那张确认卡片">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Shield}"
                            Size="13"
                            Foreground="{StaticResource WarningBrush}"
                            VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{Binding PendingApprovalText}"
                         FontSize="11.5"
                         Margin="8,0,8,0"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2"
                         Text="查看"
                         FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         VerticalAlignment="Center" />
            </Grid>
          </Button>
        </Border>

        <!-- 一次性回执：导出完给个落点，点一下打开所在文件夹；几秒后自己消失 -->
        <Border IsVisible="{Binding HasToast}"
                Background="{StaticResource SurfaceMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,6"
                Margin="0,0,0,8">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.CircleCheck}"
                          Size="13"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ToastText}"
                       FontSize="11.5"
                       Margin="8,0,8,0"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Classes="ghost-action"
                    Command="{Binding OpenToastTargetCommand}"
                    Content="{Binding ToastActionLabel}" />
            <Button Grid.Column="3"
                    Classes="icon"
                    Width="22"
                    Height="22"
                    Margin="2,0,0,0"
                    Command="{Binding DismissToastCommand}"
                    ToolTip.Tip="关掉">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.CircleX}" Size="12" />
            </Button>
          </Grid>
        </Border>

        <views:ComposerView DataContext="{Binding Composer}" MaxWidth="840" />
      </StackPanel>
    </Border>

    <!-- 点开大图：平时 IsVisible=False，不占布局也不吃事件 -->
    <controls:ImageViewer x:Name="ImageViewerLayer" Grid.RowSpan="4" />
  </Grid>
</UserControl>
