<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:AvaloniaAssistant.UI.ViewModels"
             xmlns:views="using:AvaloniaAssistant.UI.Views"
             xmlns:controls="using:AvaloniaAssistant.UI.Controls"
             x:Class="AvaloniaAssistant.UI.Views.ChatView">

  <UserControl.Styles>
    <!-- 消息列表的滚动条常驻显示：自动隐藏时只剩一条 2~3px 的细线，鼠标根本抓不住 -->
    <Style Selector="ScrollViewer.message-list /template/ ScrollBar">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <!-- 停在上面看历史时的浮标：有新内容 / 有操作待确认，点一下回到底部 -->
    <Style Selector="Button.jump-latest">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.jump-latest:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    </Style>

    <!-- 会话内查找停在哪条消息上。只加一层浅底，不动排版 -->
    <Style Selector="Border.hit">
      <Setter Property="Background" Value="#FFF6D6" />
    </Style>

    <!-- 工具调用压成一行：一次任务十几次调用，卡片会把人埋掉 -->
    <Style Selector="Button.tool-line">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="2,2" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool-line:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    </Style>

    <!-- 引用文件的可点标签：点一下在资源管理器里定位，hover 看完整路径和截断说明 -->
    <Style Selector="Button.attachment-chip">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.attachment-chip:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:UserMessageViewModel}">
      <StackPanel>
      <TextBlock Text="{Binding DateHeaderText}"
                 IsVisible="{Binding ShowDateHeader}"
                 Classes="caption"
                 FontSize="10.5"
                 HorizontalAlignment="Center"
                 Margin="0,6,0,2" />
      <!-- 查找命中时给整条消息一层浅底。Padding 6 / Margin 收 6，净位置和原来一致 -->
      <Border Classes.hit="{Binding IsSearchHit}"
              HorizontalAlignment="Right"
              CornerRadius="12"
              Padding="6"
              Margin="0,4,-6,12">
        <Grid HorizontalAlignment="Right">
        <StackPanel HorizontalAlignment="Right" Spacing="4">
          <Border Background="{StaticResource UserBubbleBrush}"
                  CornerRadius="16,16,4,16"
                  Padding="14,10"
                  MaxWidth="620">
            <SelectableTextBlock Text="{Binding Text}"
                                 TextWrapping="Wrap"
                                 FontSize="13.5"
                                 LineHeight="21" />
          </Border>

          <!-- 这一轮贴的图，缩略图跟着气泡右对齐 -->
          <ItemsControl ItemsSource="{Binding Thumbnails}"
                        IsVisible="{Binding HasImages}"
                        HorizontalAlignment="Right"
                        Margin="0,2,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="10"
                        ClipToBounds="True"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip.Tip="点开看大图"
                        PointerPressed="OnThumbnailPressed">
                  <Image Source="{Binding}" Width="120" Stretch="Uniform" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 引用了哪些文件：可点，能定位到磁盘；大小、行数、截断状态都写在下面 -->
          <ItemsControl ItemsSource="{Binding Attachments}"
                        IsVisible="{Binding HasAttachments}"
                        HorizontalAlignment="Right"
                        Margin="0,2,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="attachment-chip"
                        ToolTip.Tip="{Binding Detail}"
                        Click="OnAttachmentClick">
                  <StackPanel Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Paperclip}"
                                    Size="11"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}"
                                 FontSize="10.5"
                                 MaxWidth="220"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding Caption}"
                               FontSize="9.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="16,0,0,0" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 时间戳：隔一天回来，得知道这轮是什么时候跑的 -->
          <TextBlock Text="{Binding TimeText}"
                     ToolTip.Tip="{Binding FullTimeText}"
                     Classes="caption"
                     FontSize="9.5"
                     HorizontalAlignment="Right"
                     Margin="0,0,4,0" />
        </StackPanel>
        </Grid>
      </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AssistantMessageViewModel}">
      <StackPanel>
      <TextBlock Text="{Binding DateHeaderText}"
                 IsVisible="{Binding ShowDateHeader}"
                 Classes="caption"
                 FontSize="10.5"
                 HorizontalAlignment="Center"
                 Margin="0,6,0,2" />
      <!-- 命中的浅底铺满整块回复；Padding 6 / Margin 收 6，净位置和原来一致 -->
      <Border Classes.hit="{Binding IsSearchHit}"
              CornerRadius="12"
              Padding="6"
              Margin="-6,-4,-6,20">
        <Grid ColumnDefinitions="28,*">
        <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                        Size="14"
                        Foreground="{StaticResource AccentForegroundBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="7">
          <Border IsVisible="{Binding HasReasoning}"
                  Background="{StaticResource SurfaceMutedBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10,7">
            <StackPanel Spacing="4">
              <Button Classes="ghost-action"
                      HorizontalAlignment="Left"
                      Command="{Binding ToggleReasoningCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}" Size="12" />
                  <TextBlock Text="思考过程" FontSize="11.5" />
                  <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}" Size="11" />
                </StackPanel>
              </Button>
              <ScrollViewer MaxHeight="220"
                            IsVisible="{Binding IsReasoningOpen}"
                            VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Reasoning}"
                           TextWrapping="Wrap"
                           FontSize="11.5"
                           LineHeight="18"
                           Foreground="{StaticResource TextSecondaryBrush}" />
              </ScrollViewer>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Tools}">
            <!-- 相邻的工具卡片之间留出间距，否则连续多次调用会贴成一整块 -->
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Button Classes="tool-line" Command="{Binding ToggleCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                      <arc:ArcGlyph Data="{Binding Icon}"
                                    Size="12"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Margin="8,0,8,0"
                                 Text="{Binding Summary}"
                                 FontSize="12"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding StatusText}"
                                 IsVisible="{Binding ShowStatus}"
                                 Foreground="{Binding StatusBrush}"
                                 FontSize="10.5"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding DurationText}"
                                 Classes="caption"
                                 FontSize="10"
                                 Margin="8,0,2,0"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Button>

                  <!-- 展开的细节不再套一层卡片，只缩进一档，跟正文同一条竖线 -->
                  <StackPanel IsVisible="{Binding IsExpanded}" Margin="20,3,0,6" Spacing="4">
                    <TextBlock Text="参数" Classes="section-title" FontSize="10" />
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                      <SelectableTextBlock Text="{Binding Arguments}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                    </ScrollViewer>
                    <TextBlock Text="结果" Classes="section-title" FontSize="10" IsVisible="{Binding HasResult}" Margin="0,4,0,0" />
                    <ScrollViewer MaxHeight="200" IsVisible="{Binding HasResult}" VerticalScrollBarVisibility="Auto">
                      <SelectableTextBlock Text="{Binding Result}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                    </ScrollViewer>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <arc:Markdown Text="{Binding Text}" IsVisible="{Binding HasText}" />

          <StackPanel IsVisible="{Binding ShowTyping}" Orientation="Horizontal" Spacing="7" Margin="0,2,0,0">
            <arc:ArcSpinner Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Text="正在处理…" Classes="caption" VerticalAlignment="Center" />
          </StackPanel>

          <Border IsVisible="{Binding HasError}"
                  Background="{StaticResource DangerSubtleBrush}"
                  BorderBrush="#F0CFCB"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="10,8">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.CircleAlert}"
                              Size="13"
                              Foreground="{StaticResource DangerBrush}"
                              VerticalAlignment="Top"
                              Margin="0,1,0,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ErrorTitle}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="7,0,8,0"
                           VerticalAlignment="Center" />
                <!-- 401 点一百次重试也没用，按钮要指向真正能解决它的地方 -->
                <Button Grid.Column="2"
                        Classes="ghost-action"
                        Command="{Binding RunErrorActionCommand}"
                        IsVisible="{Binding ShowErrorAction}"
                        Content="{Binding ErrorActionLabel}"
                        Foreground="{StaticResource DangerBrush}"
                        VerticalAlignment="Top" />
              </Grid>

              <TextBlock Text="{Binding ErrorHint}"
                         IsVisible="{Binding ErrorHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         FontSize="11.5"
                         LineHeight="17"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}" />

              <!-- 原始报错留着，但压到最后一行，不占主位 -->
              <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding Error}"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="10.5"
                                     TextWrapping="Wrap"
                                     Foreground="{StaticResource TextMutedBrush}" />
              </ScrollViewer>
            </StackPanel>
          </Border>

          <!-- 用户按停不是故障：中性一行说明，不套危险色 -->
          <TextBlock IsVisible="{Binding HasStopNote}"
                     Text="已停止生成"
                     Classes="caption"
                     FontSize="11"
                     Foreground="{StaticResource TextMutedBrush}"
                     Margin="0,1,0,0" />

          <!-- 回复的操作菜单：复制要有内容才出现，重试只在这条回复真的结束（含失败/中断）后才出现 -->
          <StackPanel IsVisible="{Binding ShowActions}" Orientation="Horizontal" Spacing="2" Margin="0,1,0,0">
            <Button Classes="ghost-action"
                    Command="{Binding CopyCommand}"
                    IsVisible="{Binding HasText}"
                    Content="{Binding CopyLabel}" />
            <Button Classes="ghost-action"
                    Command="{Binding RetryCommand}"
                    ToolTip.Tip="重新生成这条回复（会丢弃它之后的内容）"
                    Content="重试" />
            <Button Classes="ghost-action"
                    Command="{Binding ContinueCommand}"
                    IsVisible="{Binding ShowContinue}"
                    ToolTip.Tip="接着这条回复往下写，已写过的内容不重来"
                    Content="继续" />
            <TextBlock Text="{Binding TokenText}"
                       IsVisible="{Binding HasTokens}"
                       Classes="caption"
                       FontSize="10"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding TimeText}"
                       ToolTip.Tip="{Binding FullTimeText}"
                       Classes="caption"
                       FontSize="9.5"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        </Grid>
      </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ApprovalMessageViewModel}">
      <StackPanel>
      <TextBlock Text="{Binding DateHeaderText}"
                 IsVisible="{Binding ShowDateHeader}"
                 Classes="caption"
                 FontSize="10.5"
                 HorizontalAlignment="Center"
                 Margin="0,6,0,2" />
      <Border Background="{StaticResource WarningSubtleBrush}"
              BorderBrush="#EBCFA4"
              BorderThickness="1"
              CornerRadius="12"
              Padding="13"
              Margin="38,6,0,10">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Shield}"
                          Size="16"
                          Foreground="{StaticResource WarningBrush}"
                          VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Label}"
                       FontSize="12.5"
                       FontWeight="Medium"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
            <Border Grid.Column="2"
                    Background="#AAFFFFFF"
                    CornerRadius="6"
                    Padding="7,2"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding ToolName}"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="9.5"
                         Foreground="{StaticResource WarningBrush}" />
            </Border>
          </Grid>
          <TextBlock Text="{Binding Reason}"
                     Classes="caption"
                     FontSize="11.5"
                     TextWrapping="Wrap" />
          <Border Background="#AAFFFFFF" CornerRadius="8" Padding="10,7">
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
              <SelectableTextBlock Text="{Binding Arguments}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
            </ScrollViewer>
          </Border>
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding ShowActions}" Margin="0,2,0,0">
            <Button Classes="approve" Command="{Binding AllowCommand}" Content="允许一次" />
            <Button Grid.Column="1"
                    Classes="deny"
                    Margin="8,0,0,0"
                    Command="{Binding DenyCommand}"
                    Content="拒绝" />
            <Button Grid.Column="3"
                    Classes="ghost-action"
                    VerticalAlignment="Center"
                    Command="{Binding AllowAlwaysCommand}"
                    ToolTip.Tip="这个工具在本次对话里不再逐次询问"
                    Content="{Binding AlwaysLabel}" />
          </Grid>
          <TextBlock Text="Ctrl+Enter 允许一次 · Ctrl+Shift+Enter 本会话允许 · Esc 拒绝"
                     IsVisible="{Binding ShowActions}"
                     Classes="caption"
                     FontSize="10"
                     HorizontalAlignment="Right" />
          <TextBlock Text="{Binding ResolutionText}"
                     IsVisible="{Binding !ShowActions}"
                     Classes="caption"
                     FontSize="11.5"
                     Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NoticeMessageViewModel}">
      <StackPanel>
      <TextBlock Text="{Binding DateHeaderText}"
                 IsVisible="{Binding ShowDateHeader}"
                 Classes="caption"
                 FontSize="10.5"
                 HorizontalAlignment="Center"
                 Margin="0,6,0,2" />
      <Border Background="{StaticResource SurfaceMutedBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="11,9"
              Margin="0,4,0,12">
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
      </Border>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="18,12,16,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Button Classes="icon" Command="{Binding BackCommand}" ToolTip.Tip="返回首页" Margin="0,0,6,0">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronLeft}" Size="16" />
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding HeaderSubtitle}" Classes="caption" FontSize="10.5" />
        </StackPanel>
        <!-- 停止已经在输入框里（运行中发送键会变成停止键），重试挂在每条回复下面，
             顶栏只留查找和状态，避免同一个动作出现两处入口。 -->
        <Button Grid.Column="2"
                Classes="icon"
                Margin="0,0,6,0"
                Command="{Binding OpenSearchCommand}"
                ToolTip.Tip="在对话里查找（Ctrl+F）">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Search}" Size="14" />
        </Button>
        <Border Grid.Column="3"
                Background="{StaticResource SurfaceMutedBrush}"
                CornerRadius="11"
                Padding="10,4"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}" Classes="caption" FontSize="10.5" />
        </Border>
      </Grid>
    </Border>

    <!-- 会话内查找：单独占一条，收起时整行不占位，也不压住正文第一行 -->
    <Border Grid.Row="1"
            IsVisible="{Binding IsSearchOpen}"
            Background="{StaticResource SurfaceMutedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="18,7">
      <StackPanel Orientation="Horizontal"
                  Spacing="6"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Search}"
                      Size="13"
                      Foreground="{StaticResource TextMutedBrush}"
                      VerticalAlignment="Center" />
        <arc:Input x:Name="SearchInput"
                   Width="188"
                   Size="Small"
                   Placeholder="在对话里查找"
                   Text="{Binding SearchQuery, Mode=TwoWay}" />
        <TextBlock Text="{Binding SearchCounter}"
                   Classes="caption"
                   FontSize="10.5"
                   MinWidth="78"
                   VerticalAlignment="Center" />
        <Button Classes="icon"
                Width="24"
                Height="24"
                Command="{Binding PreviousSearchHitCommand}"
                ToolTip.Tip="上一处（Shift+Enter）">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronUp}" Size="13" />
        </Button>
        <Button Classes="icon"
                Width="24"
                Height="24"
                Command="{Binding NextSearchHitCommand}"
                ToolTip.Tip="下一处（Enter）">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}" Size="13" />
        </Button>
        <Button Classes="icon"
                Width="24"
                Height="24"
                Command="{Binding CloseSearchCommand}"
                ToolTip.Tip="关闭（Esc）">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.CircleX}" Size="13" />
        </Button>
      </StackPanel>
    </Border>

    <!-- 消息区 + 回到底部的浮标：用户滚上去看历史时，新内容不该悄悄长在下面 -->
    <Panel Grid.Row="2">
      <ScrollViewer x:Name="MessagesScroll"
                    Classes="message-list"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="MessagesItems"
                      ItemsSource="{Binding Messages}"
                      MaxWidth="840"
                      Margin="26,22,26,10"
                      />
      </ScrollViewer>

      <Button Classes="jump-latest"
              IsVisible="{Binding ShowFloatingHint}"
              Command="{Binding JumpToLatestCommand}"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,14">
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ArrowDown}" Size="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding FloatingHint}" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Panel>

    <Border Grid.Row="3" Padding="26,8,26,14" Background="{StaticResource SurfaceBrush}">
      <views:ComposerView DataContext="{Binding Composer}" MaxWidth="840" />
    </Border>

    <!-- 点开大图：平时 IsVisible=False，不占布局也不吃事件 -->
    <controls:ImageViewer x:Name="ImageViewerLayer" Grid.RowSpan="4" />
  </Grid>
</UserControl>
