<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:controls="using:AvaloniaAssistant.UI.Controls"
             x:Class="AvaloniaAssistant.UI.Views.SidebarView">
  <UserControl.Resources>
    <!--
      侧栏里的一条对话：默认只显示时间；鼠标移到这一行，时间淡出让位给「⋯」，右键区变成入口，
      同时弹出一张信息卡（本地电脑 / 所属空间 / 更新时间）。时间用 Opacity 而不是 IsVisible，
      为的是悬停时标题宽度不跳。
    -->
    <DataTemplate x:Key="SessionRowTemplate">
      <Grid Classes="task-row"
            PointerEntered="OnSessionRowPointerEntered"
            PointerExited="OnSessionRowPointerExited">
        <Button Classes="task"
                Classes.active="{Binding IsActive}"
                Command="{Binding OpenCommand}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}"
                       FontSize="12.5"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Classes="row-time"
                       Text="{Binding TimeText}"
                       FontSize="10"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" />
          </Grid>
        </Button>

        <Button Classes="icon row-more"
                Width="22"
                Height="22"
                Margin="0,0,1,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="OnSessionMenuClick"
                ToolTip.Tip="{x:Null}">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Ellipsis}" Size="14" />
        </Button>

        <!-- 悬停信息卡：贴在侧栏右边，压在聊天区上面；不吃鼠标事件，免得挡住点击 -->
        <Popup IsOpen="{Binding IsCardOpen}"
               Placement="Right"
               HorizontalOffset="8"
               IsLightDismissEnabled="False">
          <Border Classes="hover-card" IsHitTestVisible="False">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Title}"
                         FontSize="12.5"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Laptop}"
                              Size="12"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="本地电脑"
                           FontSize="10.5"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Border Classes="tag">
                  <TextBlock Text="{Binding ModeText}"
                             FontSize="10"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Folder}"
                              Size="12"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="{Binding WorkspaceName, StringFormat='所属空间：{0}'}"
                           FontSize="10.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextSecondaryBrush}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Clock}"
                              Size="12"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="{Binding UpdatedText}"
                           FontSize="10.5"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Border Background="{StaticResource SidebarBrush}" Padding="12,16,12,10">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <controls:BrandMark Width="32" Height="32" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="Avalonia Assistant"
                     FontSize="13"
                     FontWeight="SemiBold"
                     LineHeight="16"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding VersionText}"
                     Classes="caption"
                     FontSize="10"
                     LineHeight="13"
                     VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="2"
                Classes="icon"
                Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="收起侧边栏">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.PanelLeft}" Size="15" />
        </Button>
      </Grid>

      <Button Grid.Row="1"
              Margin="0,14,0,0"
              Height="38"
              CornerRadius="10"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              HorizontalContentAlignment="Left"
              Command="{Binding NewTaskCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="15" />
          <TextBlock Text="新建任务" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <ScrollViewer Grid.Row="2"
                    Margin="0,12,0,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="2">
          <Button Classes="nav" Classes.active="{Binding IsHomeSelected}" Command="{Binding OpenHomeCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                            Size="16"
                            Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Grid.Column="1" Text="助理" Margin="9,0,0,0" VerticalAlignment="Center" />
              <Border Grid.Column="2"
                      Background="{StaticResource SurfaceMutedBrush}"
                      CornerRadius="4"
                      Padding="4,1"
                      VerticalAlignment="Center">
                <TextBlock Text="BETA" FontSize="8.5" Foreground="{StaticResource TextMutedBrush}" />
              </Border>
            </Grid>
          </Button>

          <Button Classes="nav" Classes.active="{Binding IsToolsSelected}" Command="{Binding OpenToolsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Zap}"
                            Size="16"
                            Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="技能" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav" Classes.active="{Binding IsMcpSelected}" Command="{Binding OpenMcpCommand}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Server}"
                            Size="16"
                            Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="MCP" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav" Classes.active="{Binding IsSettingsSelected}" Command="{Binding OpenSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Settings}"
                            Size="16"
                            Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="设置" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,12,8,10" />

          <!-- 「任务」是全部任务的总入口，「空间」只是另一层归类：
               归了空间的任务在这里仍然看得见，不会因为分了组就消失。 -->
          <Button Classes="nav ws-head"
                  Command="{Binding ToggleTaskSectionCommand}"
                  ToolTip.Tip="展开 / 收起全部任务">
            <Grid ColumnDefinitions="Auto,Auto,*">
              <Panel Width="12" VerticalAlignment="Center">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}"
                              Size="11"
                              IsVisible="{Binding IsTaskSectionExpanded}" />
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronRight}"
                              Size="11"
                              IsVisible="{Binding !IsTaskSectionExpanded}" />
              </Panel>
              <!-- 空出空间那一行的文件夹图标位，两区标题才对得齐 -->
              <Panel Grid.Column="1" Width="19" />
              <TextBlock Grid.Column="2"
                         Text="{Binding SessionCountText}"
                         Classes="section-title"
                         Margin="9,0,0,0"
                         VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Border IsVisible="{Binding IsTaskSectionExpanded}"
                  Margin="13,2,0,0"
                  Padding="6,0,0,0"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1,0,0,0">
            <StackPanel>
              <TextBlock Text="还没有任务，点上面「新建任务」开始。"
                         Classes="caption"
                         FontSize="10.5"
                         Margin="0,2,0,4"
                         TextWrapping="Wrap"
                         IsVisible="{Binding HasNoSessions}" />

              <ItemsControl ItemsSource="{Binding SessionGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4,0,0">
                      <TextBlock Text="{Binding Header}"
                                 Classes="caption"
                                 Margin="0,2,0,4"
                                 FontSize="10.5" />
                      <ItemsControl ItemsSource="{Binding Items}"
                                    ItemTemplate="{StaticResource SessionRowTemplate}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,12,8,10" />

          <Grid ColumnDefinitions="*,Auto" Margin="8,0,4,4">
            <TextBlock Text="{Binding WorkspaceCountText}" Classes="section-title" />
            <Button Grid.Column="1"
                    Classes="icon"
                    Width="22"
                    Height="22"
                    Command="{Binding AddWorkspaceCommand}"
                    ToolTip.Tip="新建空间">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="13" />
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding Workspaces}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- 空间之间留一点空隙，免得两组对话连成一整片 -->
                <StackPanel Margin="0,2,0,4">
                  <Border Classes="ws-chip" Classes.active="{Binding IsActive}" CornerRadius="9">
                    <Grid Classes="workspace-row" ColumnDefinitions="*,Auto,Auto">
                      <Button Classes="nav ws-head"
                              Classes.active="{Binding IsActive}"
                              Command="{Binding ToggleCommand}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                          <Panel Width="12" VerticalAlignment="Center">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}"
                                          Size="11"
                                          IsVisible="{Binding IsExpanded}" />
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronRight}"
                                          Size="11"
                                          IsVisible="{Binding !IsExpanded}" />
                          </Panel>
                          <arc:ArcGlyph Grid.Column="1"
                                        Data="{x:Static arc:ArcIcons.Folder}"
                                        Size="15"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding $parent[Button].Foreground}" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Name}"
                                     Margin="9,0,0,0"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3"
                                     Text="{Binding CountText}"
                                     IsVisible="{Binding ShowCount}"
                                     FontSize="10"
                                     Margin="6,0,2,0"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                      </Button>
                      <Button Grid.Column="1"
                              Classes="icon ws-add"
                              Width="22"
                              Height="22"
                              Margin="0,0,2,0"
                              Command="{Binding NewSessionCommand}"
                              ToolTip.Tip="新建会话">
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="12" />
                      </Button>
                      <Button Grid.Column="2"
                              Classes="icon ws-more"
                              Width="22"
                              Height="22"
                              Margin="0,0,3,0"
                              Click="OnWorkspaceMenuClick"
                              ToolTip.Tip="{x:Null}">
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Ellipsis}" Size="14" />
                      </Button>
                    </Grid>
                  </Border>

                  <!-- 空间下的对话：一条竖线把层级挂住，收起来时整块不占位 -->
                  <Border IsVisible="{Binding IsExpanded}"
                          Margin="13,2,0,0"
                          Padding="6,0,0,0"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1,0,0,0">
                    <ItemsControl ItemsSource="{Binding Sessions}"
                                  ItemTemplate="{StaticResource SessionRowTemplate}" />
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="还没有空间。点「空间」右边的 + 选一个文件夹，新建的任务就挂在这个空间下。"
                     Classes="caption"
                     FontSize="10.5"
                     Margin="8,2,8,2"
                     TextWrapping="Wrap"
                     IsVisible="{Binding !HasWorkspaces}" />
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="3"
              Margin="0,10,0,0"
              Padding="8,8"
              CornerRadius="12"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="30" Height="30" CornerRadius="15" Background="#E4E1F7">
            <TextBlock Text="{Binding UserInitial}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#4B3FA8"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding UserName}" FontSize="12.5" FontWeight="Medium" />
            <TextBlock Text="{Binding PlanText}" Classes="caption" FontSize="9.5" />
          </StackPanel>
          <Button Grid.Column="2"
                  Classes="icon"
                  Command="{Binding OpenSettingsCommand}"
                  ToolTip.Tip="设置">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Settings}" Size="14" />
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
