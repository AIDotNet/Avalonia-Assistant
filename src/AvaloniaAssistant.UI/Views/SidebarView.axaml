<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:controls="using:AvaloniaAssistant.UI.Controls"
             x:Class="AvaloniaAssistant.UI.Views.SidebarView">
  <Border Background="{StaticResource SidebarBrush}" Padding="12,16,12,10">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <controls:BrandMark Width="32" Height="32" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="Avalonia Assistant"
                     FontSize="13"
                     FontWeight="SemiBold"
                     LineHeight="16"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding VersionText}"
                     Classes="caption"
                     FontSize="10"
                     LineHeight="13"
                     VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="2"
                Classes="icon"
                Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="收起侧边栏">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.PanelLeft}" Size="15" />
        </Button>
      </Grid>

      <Button Grid.Row="1"
              Margin="0,14,0,0"
              Height="38"
              CornerRadius="10"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              HorizontalContentAlignment="Left"
              Command="{Binding NewTaskCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="15" />
          <TextBlock Text="新建任务" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <ScrollViewer Grid.Row="2"
                    Margin="0,12,0,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="2">
          <Button Classes="nav" Classes.active="{Binding IsHomeSelected}" Command="{Binding OpenHomeCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                            Size="16"
                            Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Grid.Column="1" Text="助理" Margin="9,0,0,0" VerticalAlignment="Center" />
              <Border Grid.Column="2"
                      Background="{StaticResource SurfaceMutedBrush}"
                      CornerRadius="4"
                      Padding="4,1"
                      VerticalAlignment="Center">
                <TextBlock Text="BETA" FontSize="8.5" Foreground="{StaticResource TextMutedBrush}" />
              </Border>
            </Grid>
          </Button>

          <Button Classes="nav" Classes.active="{Binding IsToolsSelected}" Command="{Binding OpenToolsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Zap}"
                            Size="16"
                            Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="技能" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav" Classes.active="{Binding IsMcpSelected}" Command="{Binding OpenMcpCommand}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Server}"
                            Size="16"
                            Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="MCP" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav" Classes.active="{Binding IsLibrarySelected}" Command="{Binding OpenLibraryCommand}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.FolderOpen}"
                            Size="16"
                            Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="资料库" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav" Classes.active="{Binding IsSettingsSelected}" Command="{Binding OpenSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Settings}"
                            Size="16"
                            Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="设置" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,12,8,10" />

          <!-- 「任务」只放没归到空间里的对话，空间里的对话挂在各自空间下面 -->
          <StackPanel IsVisible="{Binding ShowTaskSection}">
            <Grid ColumnDefinitions="*,Auto" Margin="8,0,4,4">
              <TextBlock Text="{Binding SessionCountText}" Classes="section-title" />
            </Grid>

            <TextBlock Text="还没有任务，点上面「新建任务」开始。"
                       Classes="caption"
                       FontSize="10.5"
                       Margin="8,2,0,4"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasNoSessions}" />

            <ItemsControl ItemsSource="{Binding SessionGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="{Binding Header}" Classes="caption" Margin="8,2,0,4" FontSize="10.5" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Classes="task-row" ColumnDefinitions="*,Auto">
                            <Button Classes="task"
                                    Classes.active="{Binding IsActive}"
                                    Command="{Binding OpenCommand}">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TimeText}"
                                           FontSize="10"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" />
                              </Grid>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Classes="icon delete"
                                      Command="{Binding DeleteCommand}"
                                      IsVisible="{Binding !ConfirmDelete}"
                                      ToolTip.Tip="删除任务">
                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Trash2}" Size="13" />
                              </Button>
                              <Button Classes="ghost-action"
                                      Command="{Binding DeleteCommand}"
                                      Content="确认"
                                      IsVisible="{Binding ConfirmDelete}"
                                      Foreground="{StaticResource DangerBrush}" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,12,8,10" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" Margin="8,0,4,4">
            <TextBlock Text="空间" Classes="section-title" />
            <Button Grid.Column="1"
                    Classes="icon"
                    Width="22"
                    Height="22"
                    Command="{Binding AddWorkspaceCommand}"
                    ToolTip.Tip="添加工作区">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="13" />
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding Workspaces}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- 空间之间留一点空隙，免得两组对话连成一整片 -->
                <StackPanel Margin="0,2,0,4">
                  <Border Classes="ws-chip" Classes.active="{Binding IsActive}" CornerRadius="9">
                    <Grid Classes="workspace-row" ColumnDefinitions="*,Auto">
                      <Button Classes="nav ws-head"
                              Classes.active="{Binding IsActive}"
                              Command="{Binding ToggleCommand}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                          <Panel Width="12" VerticalAlignment="Center">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}"
                                          Size="11"
                                          IsVisible="{Binding IsExpanded}" />
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronRight}"
                                          Size="11"
                                          IsVisible="{Binding !IsExpanded}" />
                          </Panel>
                          <arc:ArcGlyph Grid.Column="1"
                                        Data="{x:Static arc:ArcIcons.Folder}"
                                        Size="15"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding $parent[Button].Foreground}" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Name}"
                                     Margin="9,0,0,0"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3"
                                     Text="{Binding CountText}"
                                     IsVisible="{Binding ShowCount}"
                                     FontSize="10"
                                     Margin="6,0,2,0"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                      </Button>
                      <Button Grid.Column="1"
                              Classes="icon ws-more"
                              Width="22"
                              Height="22"
                              Margin="0,0,3,0"
                              Click="OnWorkspaceMenuClick"
                              ToolTip.Tip="{x:Null}">
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Ellipsis}" Size="14" />
                      </Button>
                    </Grid>
                  </Border>

                  <!-- 空间下的对话：一条竖线把层级挂住，收起来时整块不占位 -->
                  <Border IsVisible="{Binding IsExpanded}"
                          Margin="13,2,0,0"
                          Padding="6,0,0,0"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1,0,0,0">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Classes="task-row" ColumnDefinitions="*,Auto">
                            <Button Classes="task child"
                                    Classes.active="{Binding IsActive}"
                                    Command="{Binding OpenCommand}"
                                    ToolTip.Tip="{Binding Title}">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TimeText}"
                                           FontSize="9.5"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" />
                              </Grid>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Classes="icon delete"
                                      Command="{Binding DeleteCommand}"
                                      IsVisible="{Binding !ConfirmDelete}"
                                      ToolTip.Tip="删除任务">
                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Trash2}" Size="12" />
                              </Button>
                              <Button Classes="ghost-action"
                                      Command="{Binding DeleteCommand}"
                                      Content="确认"
                                      IsVisible="{Binding ConfirmDelete}"
                                      Foreground="{StaticResource DangerBrush}" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="没有工作区，任务按普通对话处理。"
                     Classes="caption"
                     FontSize="10.5"
                     Margin="8,2,0,2"
                     TextWrapping="Wrap"
                     IsVisible="{Binding !HasWorkspaces}" />

          <Button Classes="nav" Command="{Binding AddWorkspaceCommand}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}"
                            Size="15"
                            Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="添加工作区" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="3"
              Margin="0,10,0,0"
              Padding="8,8"
              CornerRadius="12"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="30" Height="30" CornerRadius="15" Background="#E4E1F7">
            <TextBlock Text="{Binding UserInitial}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#4B3FA8"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding UserName}" FontSize="12.5" FontWeight="Medium" />
            <TextBlock Text="{Binding PlanText}" Classes="caption" FontSize="9.5" />
          </StackPanel>
          <Button Grid.Column="2"
                  Classes="icon"
                  Command="{Binding OpenSettingsCommand}"
                  ToolTip.Tip="设置">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Settings}" Size="14" />
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
