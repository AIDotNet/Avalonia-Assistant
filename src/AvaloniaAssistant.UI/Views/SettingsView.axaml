<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="AvaloniaAssistant.UI.Views.SettingsView">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12,20,12">
      <Grid ColumnDefinitions="Auto,*">
        <Button Classes="icon" Command="{Binding BackCommand}" ToolTip.Tip="返回">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronLeft}" Size="16" />
        </Button>
        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="设置" FontSize="14" FontWeight="Medium" />
          <TextBlock Text="模型服务、权限与工作区" Classes="caption" FontSize="10.5" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="96,22,96,26" Spacing="20">

        <StackPanel Spacing="12">
          <TextBlock Text="模型服务" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="所有请求直接发往你填写的端点；密钥只保存在本机的 settings.json。"
                     Classes="caption"
                     TextWrapping="Wrap" />

          <ItemsControl ItemsSource="{Binding Providers}" Margin="0,2,0,4">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="provider"
                        Classes.selected="{Binding IsSelected}"
                        Command="{Binding SelectCommand}"
                        Margin="0,0,8,8">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" />
                    <TextBlock Text="{Binding Description}"
                               Classes="caption"
                               FontSize="10.5"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <arc:Input x:Name="KeyBox"
                     Label="API Key"
                     Placeholder="sk-..."
                     Text="{Binding ApiKey, Mode=TwoWay}"
                     PasswordChar="●">
            <arc:Input.Suffix>
              <Button Classes="icon"
                      Click="OnRevealKeyClick"
                      ToolTip.Tip="显示/隐藏密钥">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Eye}" Size="15" />
              </Button>
            </arc:Input.Suffix>
          </arc:Input>

          <arc:Input Label="Base URL"
                     Placeholder="https://api.deepseek.com/v1"
                     Text="{Binding BaseUrl, Mode=TwoWay}" />

          <arc:Input Label="模型"
                     Placeholder="deepseek-flash"
                     Text="{Binding Model, Mode=TwoWay}" />

          <StackPanel Spacing="7">
            <TextBlock Text="协议" Classes="caption" FontSize="11.5" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="chip"
                      Classes.active="{Binding IsChatProtocolSelected}"
                      Command="{Binding SetProtocolCommand}"
                      CommandParameter="chat"
                      Content="Chat Completions" />
              <Button Classes="chip"
                      Classes.active="{Binding IsResponsesProtocolSelected}"
                      Command="{Binding SetProtocolCommand}"
                      CommandParameter="responses"
                      Content="Responses" />
              <Button Classes="chip"
                      Classes.active="{Binding IsMessagesProtocolSelected}"
                      Command="{Binding SetProtocolCommand}"
                      CommandParameter="messages"
                      Content="Anthropic Messages" />
            </StackPanel>
            <TextBlock Text="{Binding ProtocolHint}"
                       Classes="caption"
                       TextWrapping="Wrap"
                       LineHeight="18" />
          </StackPanel>

          <Grid ColumnDefinitions="*,*">
            <arc:Input Label="Temperature"
                       Text="{Binding Temperature, Mode=TwoWay}"
                       Margin="0,0,8,0" />
            <arc:Input Grid.Column="1"
                       Label="Max tokens"
                       Text="{Binding MaxTokens, Mode=TwoWay}"
                       Margin="8,0,0,0" />
          </Grid>
        </StackPanel>

        <Border Height="1" Background="{StaticResource BorderBrush}" />

        <StackPanel Spacing="10">
          <TextBlock Text="权限与工作区" FontSize="15" FontWeight="SemiBold" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="chip"
                    Classes.active="{Binding IsReadOnlySelected}"
                    Command="{Binding SetPermissionCommand}"
                    CommandParameter="readonly"
                    Content="只读" />
            <Button Classes="chip"
                    Classes.active="{Binding IsWorkspaceSelected}"
                    Command="{Binding SetPermissionCommand}"
                    CommandParameter="workspace"
                    Content="默认权限" />
            <Button Classes="chip"
                    Classes.active="{Binding IsFullAccessSelected}"
                    Click="OnFullAccessClick"
                    Content="完全访问" />
          </StackPanel>

          <TextBlock Text="只读：只读工作区，不改文件、不执行命令。默认权限：工作区可读写，执行命令与调用 MCP 前先问你。完全访问：所有工具直接执行，不再逐次确认。"
                     Classes="caption"
                     TextWrapping="Wrap"
                     LineHeight="18" />

          <Grid ColumnDefinitions="*,Auto">
            <arc:Input Label="工作区"
                       Text="{Binding WorkspacePath}"
                       IsReadOnly="True" />
            <Button Grid.Column="1"
                    Classes="ghost-action"
                    Height="36"
                    Padding="12,0"
                    Margin="8,22,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding BrowseWorkspaceCommand}"
                    Content="选择…" />
          </Grid>
        </StackPanel>

        <Border Height="1" Background="{StaticResource BorderBrush}" />

        <StackPanel Spacing="8">
          <TextBlock Text="关于" FontSize="15" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="86,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Text="版本" FontSize="12" Margin="0,4" />
            <TextBlock Grid.Column="1" Text="Avalonia Assistant 1.0.0" FontSize="12" Margin="0,4" />
            <TextBlock Grid.Row="1" Text="技术栈" FontSize="12" Margin="0,4" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Avalonia 12 · TKCode.Arc · pi.net" FontSize="12" Margin="0,4" />
            <TextBlock Grid.Row="2" Text="数据目录" FontSize="12" Margin="0,4" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DataFolder}" FontSize="12" Margin="0,4" TextTrimming="CharacterEllipsis" />
          </Grid>
          <Button Classes="ghost-action"
                  HorizontalAlignment="Left"
                  Command="{Binding OpenDataFolderCommand}"
                  Content="打开数据目录" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding SavedText}"
                   Classes="caption"
                   Foreground="{Binding SaveToastBrush}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1"
                Classes="approve"
                Height="34"
                Padding="18,0"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding !IsSaving}"
                Content="{Binding SaveButtonText}" />
      </Grid>
    </Border>

    <Border Grid.RowSpan="3"
            Classes="save-toast"
            Classes.error="{Binding IsSaveError}"
            IsVisible="{Binding ShowSaveToast}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,62,24,0">
      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
        <arc:ArcGlyph Data="{Binding SaveToastIcon}"
                      Size="15"
                      Foreground="{Binding SaveToastBrush}"
                      VerticalAlignment="Center" />
        <TextBlock Text="{Binding SaveToastText}"
                   FontSize="12"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
