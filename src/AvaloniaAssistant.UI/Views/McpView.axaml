<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="AvaloniaAssistant.UI.Views.McpView">
  <Grid RowDefinitions="Auto,*">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,10,20,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="icon" Command="{Binding BackCommand}" ToolTip.Tip="{Binding BackHint}">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronLeft}" Size="16" />
        </Button>
        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="MCP" FontSize="14" FontWeight="Medium" />
          <TextBlock Text="{Binding CountText}" Classes="caption" FontSize="10.5" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button Classes="pill"
                  Command="{Binding RefreshCommand}"
                  ToolTip.Tip="重新读取 mcp.json">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.RefreshCw}" Size="12" />
              <TextBlock Text="重新扫描" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="pill"
                  Command="{Binding ShowFormCommand}"
                  ToolTip.Tip="只加一个服务端，填名称和启动命令">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="12" />
              <TextBlock Text="表单添加" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="pill"
                  Command="{Binding ShowImportCommand}"
                  ToolTip.Tip="整段粘贴标准 mcp.json，多个服务端一次写进去">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.FileText}" Size="12" />
              <TextBlock Text="导入 JSON" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="96,16,96,24" Spacing="12">
        <TextBlock Text="MCP 服务端给模型接外部工具。配置写在 mcp.json，新加的条目在下一个会话启动时连接；工具名是 mcp__&lt;服务端&gt;__&lt;工具&gt;。下面每张卡的状态是页面真的起一次进程握手的结果——配置在，不代表连得上。"
                   Classes="caption"
                   TextWrapping="Wrap"
                   LineHeight="19" />

        <Border IsVisible="{Binding HasNotice}"
                Background="{Binding NoticeBackground}"
                CornerRadius="8"
                Padding="12,8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Notice}"
                       Foreground="{Binding NoticeForeground}"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       LineHeight="17"
                       VerticalAlignment="Center" />
            <!-- 删除后 10 秒内可以按原样放回去，env / headers 不改 -->
            <Button Grid.Column="1"
                    Classes="ghost-action"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding UndoRemoveCommand}"
                    IsVisible="{Binding CanUndo}"
                    Content="撤销" />
          </Grid>
        </Border>

        <!-- 导入 JSON：主路径，粘一段标准配置就行 -->
        <Border Classes="tool-tile" IsVisible="{Binding IsImportOpen}" Padding="14,12">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="粘贴 mcp.json"
                         FontSize="12.5"
                         FontWeight="Medium"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="ghost-action"
                      Command="{Binding FillExampleCommand}"
                      ToolTip.Tip="填入一份能直接跑的示例，改个路径就能用"
                      Content="填入示例" />
            </Grid>

            <!-- 用 arc:Textarea 而不是 TextBox：本应用的控件主题里没有 TextBox 的模板，
                 裸 TextBox 只会画出一个空框（正文和占位文字都不渲染）。 -->
            <Border Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8">
              <arc:Textarea Classes="composer"
                            AcceptsReturn="True"
                            MinHeight="176"
                            MaxHeight="272"
                            IsResizable="False"
                            FontFamily="{StaticResource MonoFontFamily}"
                            FontSize="11.5"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            CaretBrush="{StaticResource TextPrimaryBrush}"
                            Placeholder="在这里粘贴 mcpServers 整段配置…"
                            Text="{Binding ImportJson, Mode=TwoWay}" />
            </Border>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="mcpServers 写法、VS Code 的 servers 写法，或者直接给一层「名称 → 配置」都能认。stdio 填 command / args，远程填 url / headers；exposure 自动补 direct，npx 这类命令自动补 Windows 启动层。"
                         Classes="caption"
                         FontSize="10.5"
                         TextWrapping="Wrap"
                         LineHeight="16"
                         Margin="0,0,10,0" />
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Bottom">
                <Button Classes="ghost-action"
                        Command="{Binding ImportFileCommand}"
                        ToolTip.Tip="选一个现成的 mcp.json 读进来，确认后再导入"
                        Content="从文件…" />
                <Button Classes="chip"
                        Classes.active="{Binding OverwriteExisting}"
                        Command="{Binding ToggleOverwriteCommand}"
                        ToolTip.Tip="同名服务端是覆盖，还是留着原来的"
                        Content="覆盖同名" />
                <Button Classes="pill"
                        Content="取消"
                        Command="{Binding CancelImportCommand}" />
                <Button Classes="pill"
                        Content="导入"
                        Command="{Binding ImportCommand}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 表单：只想加一个 stdio 服务端时更直接 -->
        <Border Classes="tool-tile" IsVisible="{Binding IsFormOpen}" Padding="14,12">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding FormTitle}"
                       FontSize="12.5"
                       FontWeight="Medium" />
            <Grid ColumnDefinitions="56,*"
                  RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="8"
                  ColumnSpacing="10">
              <TextBlock Text="名称"
                         Classes="caption"
                         FontSize="11"
                         VerticalAlignment="Center" />
              <arc:Input Grid.Column="1"
                         Size="Small"
                         Placeholder="filesystem"
                         Text="{Binding Name, Mode=TwoWay}" />

              <TextBlock Grid.Row="1"
                         Text="命令"
                         Classes="caption"
                         FontSize="11"
                         VerticalAlignment="Center" />
              <arc:Input Grid.Row="1"
                         Grid.Column="1"
                         Size="Small"
                         Placeholder="npx"
                         Text="{Binding Command, Mode=TwoWay}" />

              <TextBlock Grid.Row="2"
                         Text="参数"
                         Classes="caption"
                         FontSize="11"
                         VerticalAlignment="Center" />
              <arc:Input Grid.Row="2"
                         Grid.Column="1"
                         Size="Small"
                         Placeholder="-y @modelcontextprotocol/server-filesystem D:/work"
                         Text="{Binding Args, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="参数按空格拆成数组；exposure 自动写 direct，npx / npm 会自动补 Windows 启动层。要写 env、headers 或一次加多个，用「导入 JSON」。"
                         Classes="caption"
                         FontSize="10.5"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         LineHeight="16" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="pill"
                        Content="取消"
                        Command="{Binding CancelFormCommand}" />
                <Button Classes="pill"
                        Content="{Binding SaveLabel}"
                        Command="{Binding SaveCommand}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 两张一行：MCP 卡片要放下 target 和连接状态，三列会把失败原因挤成一条省略号 -->
        <ItemsControl ItemsSource="{Binding Servers}" Margin="0,0,-12,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="tool-tile" Margin="0,0,12,12" ToolTip.Tip="{Binding Target}">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                  <Border Width="34"
                          Height="34"
                          CornerRadius="10"
                          Background="#EFF1F4">
                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Server}"
                                  Size="17"
                                  Foreground="#5B6472"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                  </Border>

                  <Grid Grid.Column="1" Margin="10,0,0,0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1"
                            Background="{StaticResource SurfaceMutedBrush}"
                            CornerRadius="5"
                            Padding="5,1"
                            VerticalAlignment="Center">
                      <Panel>
                        <TextBlock Text="项目级"
                                   IsVisible="{Binding IsProjectScope}"
                                   FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="用户级"
                                   IsVisible="{Binding !IsProjectScope}"
                                   FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}" />
                      </Panel>
                    </Border>
                  </Grid>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                    <Button Classes="icon"
                            Width="22"
                            Height="22"
                            Command="{Binding $parent[ItemsControl].DataContext.EditCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="编辑这条配置（命令、参数、名称）">
                      <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Pencil}"
                                    Size="12"
                                    Foreground="{StaticResource TextMutedBrush}" />
                    </Button>
                    <Button Classes="icon"
                            Width="22"
                            Height="22"
                            Command="{Binding StartDeleteCommand}"
                            ToolTip.Tip="从 mcp.json 移除">
                      <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Trash2}"
                                    Size="13"
                                    Foreground="{StaticResource TextMutedBrush}" />
                    </Button>
                  </StackPanel>

                  <StackPanel Grid.Row="1"
                              Grid.ColumnSpan="3"
                              Margin="0,9,0,0"
                              Spacing="4">
                    <TextBlock Text="{Binding Target}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- 配置在 ≠ 连上了。这一行是真起进程握手之后的结果 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Detail}">
                      <Border Width="6"
                              Height="6"
                              CornerRadius="3"
                              Background="{Binding StatusBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding StatusText}"
                                 FontSize="10.5"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 TextWrapping="Wrap"
                                 MaxLines="2"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="2"
                              Classes="ghost-action"
                              Content="重试"
                              FontSize="10"
                              Padding="4,0"
                              Margin="8,0,0,0"
                              Command="{Binding $parent[ItemsControl].DataContext.ProbeCommand}"
                              CommandParameter="{Binding}"
                              IsVisible="{Binding ShowRetry}"
                              ToolTip.Tip="重新起一次进程做握手" />
                    </Grid>
                  </StackPanel>

                  <!-- 删除确认就地展开：删掉的是整段配置，别让它一键消失 -->
                  <Border Grid.Row="2"
                          Grid.ColumnSpan="3"
                          IsVisible="{Binding IsConfirmingDelete}"
                          Background="{StaticResource DangerSubtleBrush}"
                          BorderBrush="#F0CFCB"
                          BorderThickness="1"
                          CornerRadius="9"
                          Padding="9,7"
                          Margin="0,9,0,0">
                    <StackPanel Spacing="7">
                      <TextBlock Text="从 mcp.json 移除这个服务端？env 和 headers 会一起删掉。"
                                 FontSize="11"
                                 LineHeight="16"
                                 TextWrapping="Wrap"
                                 Foreground="{StaticResource DangerBrush}" />
                      <StackPanel Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  Spacing="8">
                        <Button Classes="ghost-action"
                                Content="取消"
                                Command="{Binding CancelDeleteCommand}" />
                        <Button Classes="danger"
                                Content="删除"
                                Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border IsVisible="{Binding !HasServers}" Classes="tool-tile" Padding="14,12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Server}"
                          Size="16"
                          Foreground="{StaticResource TextMutedBrush}"
                          VerticalAlignment="Top"
                          Margin="0,1,0,0" />
            <StackPanel Spacing="3">
              <TextBlock Text="还没有 MCP 服务端" FontSize="12.5" FontWeight="Medium" />
              <TextBlock Text="{Binding EmptyHint}"
                         Classes="caption"
                         FontSize="11"
                         TextWrapping="Wrap"
                         LineHeight="16" />
              <TextBlock Text="{Binding ConfigPathText}"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="10.5"
                         Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
