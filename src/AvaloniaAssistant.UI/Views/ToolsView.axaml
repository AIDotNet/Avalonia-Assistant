<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="AvaloniaAssistant.UI.Views.ToolsView">
  <Grid RowDefinitions="Auto,*">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,10,20,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="icon" Command="{Binding BackCommand}" ToolTip.Tip="返回">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronLeft}" Size="16" />
        </Button>
        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="技能" FontSize="14" FontWeight="Medium" />
          <TextBlock Text="{Binding SubtitleText}" Classes="caption" FontSize="10.5" />
        </StackPanel>
        <arc:SearchField Grid.Column="2"
                         Width="232"
                         Size="Small"
                         Placeholder="搜索技能"
                         Text="{Binding SearchText, Mode=TwoWay}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="96,16,96,24" Spacing="12">
        <TextBlock Text="技能来自 SKILL.md，工具是本机能力。关掉的工具不会进入模型上下文；执行命令仍需逐次确认。"
                   Classes="caption"
                   TextWrapping="Wrap"
                   LineHeight="19" />

        <Border IsVisible="{Binding HasNotice}"
                Background="{Binding NoticeBackground}"
                CornerRadius="8"
                Padding="12,8">
          <TextBlock Text="{Binding Notice}"
                     Foreground="{Binding NoticeForeground}"
                     FontSize="11.5"
                     TextWrapping="Wrap"
                     LineHeight="17" />
        </Border>

        <!-- 技能 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
          <TextBlock Text="技能" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{Binding CapabilityText}"
                     Classes="caption"
                     FontSize="10.5"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button Classes="pill"
                    Command="{Binding OpenSkillsFolderCommand}"
                    ToolTip.Tip="在资源管理器里打开技能目录">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Folder}" Size="12" />
                <TextBlock Text="打开目录" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill"
                    Command="{Binding RefreshCapabilitiesCommand}"
                    ToolTip.Tip="重新扫描技能目录">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.RefreshCw}" Size="12" />
                <TextBlock Text="重新扫描" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill"
                    Command="{Binding InstallSkillCommand}"
                    ToolTip.Tip="选一个含 SKILL.md 的文件夹装进来">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="12" />
                <TextBlock Text="导入文件夹" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill"
                    Command="{Binding InstallSkillZipCommand}"
                    ToolTip.Tip="选一个含 SKILL.md 的 zip 技能包装进来">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="12" />
                <TextBlock Text="导入 zip" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <ItemsControl ItemsSource="{Binding VisibleSkills}" Margin="0,0,-12,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="tool-tile" Margin="0,0,12,12" ToolTip.Tip="{Binding Directory}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                  <Border Width="34"
                          Height="34"
                          CornerRadius="10"
                          Background="#FCE9F1">
                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                                  Size="17"
                                  Foreground="#C2417B"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                  </Border>

                  <Grid Grid.Column="1" Margin="10,0,0,0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1"
                            Background="{StaticResource SurfaceMutedBrush}"
                            CornerRadius="5"
                            Padding="5,1"
                            VerticalAlignment="Center">
                      <Panel>
                        <TextBlock Text="项目级"
                                   IsVisible="{Binding IsProjectScope}"
                                   FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="用户级"
                                   IsVisible="{Binding !IsProjectScope}"
                                   FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}" />
                      </Panel>
                    </Border>
                  </Grid>

                  <TextBlock Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Margin="0,9,0,0"
                             Text="{Binding Description}"
                             Classes="caption"
                             FontSize="11.5"
                             LineHeight="16"
                             TextWrapping="Wrap"
                             MaxLines="2"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border IsVisible="{Binding !HasSkills}" Classes="tool-tile" Padding="14,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="32"
                    Height="32"
                    CornerRadius="9"
                    Background="#FCE9F1"
                    VerticalAlignment="Top">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                            Size="15"
                            Foreground="#C2417B"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,12,0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="还没有技能" FontSize="12.5" FontWeight="Medium" />
              <TextBlock Text="{Binding SkillsEmptyHint}" Classes="caption" FontSize="11" />
              <TextBlock Text="{Binding SkillsRootText}"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="10"
                         Foreground="{StaticResource TextMutedBrush}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2"
                    Classes="chip"
                    Height="28"
                    Padding="12,0"
                    Content="重新扫描"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCapabilitiesCommand}" />
          </Grid>
        </Border>

        <!-- 工具 -->
        <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0">
          <TextBlock Text="工具" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="关掉后不会出现在模型可用的工具里"
                     Classes="caption"
                     FontSize="10.5"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center" />
        </Grid>

        <arc:ChipGroup Label="工具分类"
                       IsMultiple="False"
                       HorizontalAlignment="Left"
                       ItemsSource="{Binding Categories}"
                       SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

        <ItemsControl ItemsSource="{Binding VisibleTools}" Margin="0,2,-12,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="tool-tile" Margin="0,0,12,12">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                  <Border Width="34"
                          Height="34"
                          CornerRadius="10"
                          Background="{Binding TileBrush}">
                    <arc:ArcGlyph Data="{Binding Icon}"
                                  Size="17"
                                  Foreground="{Binding AccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                  </Border>

                  <Grid Grid.Column="1" Margin="10,0,0,0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}"
                               FontSize="13"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <arc:Switch Grid.Column="1"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                Opacity="0.9"
                                RenderTransformOrigin="100%,50%"
                                RenderTransform="scale(0.86)" />
                  </Grid>

                  <TextBlock Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Margin="0,9,0,0"
                             Text="{Binding Description}"
                             Classes="caption"
                             FontSize="11.5"
                             LineHeight="16"
                             TextWrapping="Wrap"
                             MaxLines="2"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Description}" />

                  <StackPanel Grid.Row="2"
                              Grid.ColumnSpan="2"
                              Orientation="Horizontal"
                              Spacing="5"
                              Margin="0,8,0,0">
                    <TextBlock Text="{Binding ApprovalText}"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="·" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding MutatingText}"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="·" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ParameterText}"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <arc:EmptyState IsVisible="{Binding HasNothing}"
                        Icon="{x:Static arc:ArcIcons.Search}"
                        Title="没有匹配的技能或工具"
                        Description="换个关键词，或者切回「全部」。">
          <arc:EmptyState.Action>
            <Button Classes="chip"
                    Content="清空搜索"
                    Command="{Binding ClearSearchCommand}" />
          </arc:EmptyState.Action>
        </arc:EmptyState>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
