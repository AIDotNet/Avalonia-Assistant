<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="AvaloniaAssistant.UI.Views.ToolsView">
  <Grid RowDefinitions="Auto,*">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12,20,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="icon" Command="{Binding BackCommand}" ToolTip.Tip="返回">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronLeft}" Size="16" />
        </Button>
        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="技能" FontSize="14" FontWeight="Medium" />
          <TextBlock Text="{Binding ToolCountText}" Classes="caption" FontSize="10.5" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="96,20,96,26" Spacing="16">
        <TextBlock Text="助手可以调用的本机能力。关闭后不会出现在模型可用的工具里；执行命令、结束进程等高风险动作仍会逐次征求你的同意。"
                   Classes="caption"
                   TextWrapping="Wrap"
                   LineHeight="19" />

        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="8" Margin="0,0,0,18">
                <TextBlock Text="{Binding Name}" Classes="section-title" Margin="2,0,0,2" />

                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card" Padding="14" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource SurfaceMutedBrush}" VerticalAlignment="Top">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Zap}"
                                          Size="16"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                          </Border>

                          <StackPanel Grid.Column="1" Margin="11,0,12,0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium" />
                              <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ApprovalText}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                              </Border>
                              <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MutatingText}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" LineHeight="17" />
                            <TextBlock Text="{Binding ParameterText}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="9.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                          </StackPanel>

                          <arc:Switch Grid.Column="2"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
