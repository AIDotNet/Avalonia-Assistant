<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="AvaloniaAssistant.UI.Views.ToolsView">
  <Grid RowDefinitions="Auto,*">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,10,20,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="icon" Command="{Binding BackCommand}" ToolTip.Tip="{Binding BackHint}">
          <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronLeft}" Size="16" />
        </Button>
        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="技能" FontSize="14" FontWeight="Medium" />
          <TextBlock Text="{Binding SubtitleText}" Classes="caption" FontSize="10.5" />
          <!-- 从哪条任务进来的写在页头上：只挂返回键的悬停提示，用户得先知道要悬停 -->
          <Button Classes="ghost-action"
                  Margin="-6,2,0,0"
                  HorizontalAlignment="Left"
                  IsVisible="{Binding HasReturnTarget}"
                  Command="{Binding BackCommand}"
                  ToolTip.Tip="{Binding BackHint}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronLeft}"
                            Size="11"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextMutedBrush}" />
              <TextBlock Text="{Binding BackHint}"
                         FontSize="11"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock Text="改完回来接着看"
                         FontSize="11"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <arc:SearchField Grid.Column="2"
                         Width="232"
                         Size="Small"
                         Placeholder="搜索技能"
                         Text="{Binding SearchText, Mode=TwoWay}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="96,16,96,24" Spacing="12">
        <!-- 页首不放说明。开关的后果每次切换都会以提示条说一遍（ToolsViewModel 的 ShowNotice），
             工具卡上也标了「需要确认 / 自动执行」，不需要常驻小字。 -->

        <Border IsVisible="{Binding HasNotice}"
                Background="{Binding NoticeBackground}"
                CornerRadius="8"
                Padding="12,8">
          <TextBlock Text="{Binding Notice}"
                     Foreground="{Binding NoticeForeground}"
                     FontSize="11.5"
                     TextWrapping="Wrap"
                     LineHeight="17" />
        </Border>

        <!-- 技能 / 技能市场 两个分页。tab 和当前分页的操作按钮放在同一行：
             切 tab 时按钮跟着换，不会再让两组无关的按钮挤在一个工具栏里。 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
          <Border Classes="tabbar">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="tab"
                      Classes.active="{Binding ShowingSkills}"
                      Command="{Binding ShowSkillsTabCommand}"
                      ToolTip.Tip="技能目录里的 SKILL.md">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="技能" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Skills.Count}"
                             FontSize="11"
                             Opacity="0.5"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="tab"
                      Classes.active="{Binding ShowingSkillMarket}"
                      Command="{Binding ShowSkillMarketTabCommand}"
                      ToolTip.Tip="skills.sh 上的公开技能">
                <TextBlock Text="技能市场" VerticalAlignment="Center" />
              </Button>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowingSkills}">
            <Button Classes="pill"
                    Command="{Binding OpenSkillsFolderCommand}"
                    ToolTip.Tip="在资源管理器里打开技能目录">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Folder}" Size="12" />
                <TextBlock Text="打开目录" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill"
                    Command="{Binding RefreshCapabilitiesCommand}"
                    ToolTip.Tip="重新扫描技能目录">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.RefreshCw}" Size="12" />
                <TextBlock Text="重新扫描" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill"
                    Command="{Binding InstallSkillCommand}"
                    ToolTip.Tip="选一个含 SKILL.md 的文件夹装进来">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="12" />
                <TextBlock Text="导入文件夹" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill"
                    Command="{Binding InstallSkillZipCommand}"
                    ToolTip.Tip="选一个含 SKILL.md 的 zip 技能包装进来">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="12" />
                <TextBlock Text="导入 zip" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- 技能分页 -->
        <StackPanel IsVisible="{Binding ShowingSkills}" Spacing="12">
          <TextBlock Text="{Binding CapabilityText}"
                     Classes="caption"
                     FontSize="10.5"
                     IsVisible="{Binding HasCapabilityText}" />

        <ItemsControl ItemsSource="{Binding VisibleSkills}" Margin="0,0,-12,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="tool-tile" Margin="0,0,12,12" ToolTip.Tip="{Binding Directory}">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                  <Border Width="34"
                          Height="34"
                          CornerRadius="10"
                          Background="#FCE9F1">
                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                                  Size="17"
                                  Foreground="#C2417B"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                  </Border>

                  <Grid Grid.Column="1" Margin="10,0,0,0" ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1"
                            Background="{StaticResource SurfaceMutedBrush}"
                            CornerRadius="5"
                            Padding="5,1"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding ScopeText}"
                                 FontSize="9"
                                 Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                    <!-- 关掉的技能不进系统提示，但 SKILL.md 一个字都不动；下一轮生效 -->
                    <arc:Switch Grid.Column="2"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                Opacity="0.9"
                                RenderTransformOrigin="100%,50%"
                                RenderTransform="scale(0.86)"
                                ToolTip.Tip="关掉后这一轮不再把它放进系统提示（文件保留）" />
                  </Grid>

                  <TextBlock Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Margin="0,9,0,0"
                             Text="{Binding Description}"
                             Classes="caption"
                             FontSize="11.5"
                             LineHeight="16"
                             TextWrapping="Wrap"
                             MaxLines="2"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Description}" />

                  <Button Grid.Row="2"
                          Grid.ColumnSpan="2"
                          Classes="ghost-action"
                          HorizontalAlignment="Left"
                          Margin="0,8,0,0"
                          Command="{Binding $parent[ItemsControl].DataContext.PreviewSkillCommand}"
                          CommandParameter="{Binding}"
                          Content="查看 SKILL.md"
                          ToolTip.Tip="看这个技能的正文：触发条件、步骤、用到的工具" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border IsVisible="{Binding !HasSkills}" Classes="tool-tile" Padding="14,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="32"
                    Height="32"
                    CornerRadius="9"
                    Background="#FCE9F1"
                    VerticalAlignment="Top">
              <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                            Size="15"
                            Foreground="#C2417B"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,12,0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="还没有技能" FontSize="12.5" FontWeight="Medium" />
              <TextBlock Text="{Binding SkillsEmptyHint}" Classes="caption" FontSize="11" />
              <TextBlock Text="{Binding SkillsRootText}"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="10"
                         Foreground="{StaticResource TextMutedBrush}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2"
                    Classes="chip"
                    Height="28"
                    Padding="12,0"
                    Content="重新扫描"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCapabilitiesCommand}" />
          </Grid>
        </Border>
        </StackPanel>

        <!-- 技能市场分页：数据来自 skills.sh 的公开接口，安装走官方 CLI（npx skills add）。
             技能在仓库里的路径是任意的（skills/engineering/tdd 这种），自己拼 raw URL 拼不出来。 -->
        <StackPanel IsVisible="{Binding ShowingSkillMarket}" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <arc:SearchField x:Name="SkillMarketSearch"
                             Width="320"
                             Size="Small"
                             HorizontalAlignment="Left"
                             Placeholder="搜技能（skills.sh，至少两个字）"
                             Text="{Binding MarketQuery, Mode=TwoWay}" />
            <Button Grid.Column="1"
                    Classes="pill"
                    Content="搜索"
                    Command="{Binding SearchMarketCommand}" />
          </Grid>

          <TextBlock Text="公开技能目录，装完就和本地技能一样用。"
                     Classes="caption"
                     FontSize="10.5"
                     IsVisible="{Binding !IsSearchingMarket}" />

          <TextBlock Text="正在搜 skills.sh…"
                     Classes="caption"
                     FontSize="10.5"
                     IsVisible="{Binding IsSearchingMarket}" />

          <Border IsVisible="{Binding HasMarketNotice}"
                  Background="{StaticResource SurfaceMutedBrush}"
                  CornerRadius="8"
                  Padding="12,8">
            <TextBlock Text="{Binding MarketNotice}"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       LineHeight="17" />
          </Border>

          <!-- 还没搜过：这张卡负责说清这块是什么、怎么用，不摆一句「暂无数据」了事 -->
          <Border IsVisible="{Binding ShowMarketEmpty}" Classes="tool-tile" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*">
              <Border Width="32"
                      Height="32"
                      CornerRadius="9"
                      Background="#FCE9F1"
                      VerticalAlignment="Top">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                              Size="15"
                              Foreground="#C2417B"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="搜 skills.sh 上的技能" FontSize="12.5" FontWeight="Medium" />
                <TextBlock Text="上面填个关键词（至少两个字），回车或点「搜索」。挑中哪个点「安装」，它就会落到你的技能目录里。"
                           Classes="caption"
                           FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding MarketSkills}" Margin="0,0,-12,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="tool-tile" Margin="0,0,12,12" ToolTip.Tip="{Binding Url}">
                  <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="10"
                            Background="#FCE9F1">
                      <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                                    Size="17"
                                    Foreground="#C2417B"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                    </Border>

                    <Grid Grid.Column="1" Margin="10,0,0,0" ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="13"
                                 FontWeight="Medium"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1"
                              Classes="chip"
                              Height="28"
                              Padding="12,0"
                              Content="{Binding ActionText}"
                              IsEnabled="{Binding CanInstall}"
                              Command="{Binding InstallCommand}" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Margin="0,9,0,0"
                               Text="{Binding Description}"
                               Classes="caption"
                               FontSize="11.5"
                               LineHeight="16"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Description}" />

                    <StackPanel Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Spacing="5"
                                Margin="0,8,0,0">
                      <Border Classes="tag" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source}"
                                   FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="150" />
                      </Border>
                      <TextBlock Text="·" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                      <TextBlock Text="{Binding InstallsText}"
                                 FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" />
                      <TextBlock Text="次安装" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 内置工具（读文件 / 执行命令 / 看时间这些）不在这页：技能页只管 SKILL.md 和插件带来的工具。 -->
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
