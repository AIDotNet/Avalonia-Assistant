<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AvaloniaAssistant.UI</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="TKCode.Arc" />
    <PackageReference Include="TKCode.Arc.Fonts" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AvaloniaAssistant.Abstractions\AvaloniaAssistant.Abstractions.csproj" />
    <ProjectReference Include="..\AvaloniaAssistant.Storage\AvaloniaAssistant.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
    <AvaloniaResource Include="Assets\app.png" />
  </ItemGroup>
</Project>
